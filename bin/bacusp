#!/bin/sh
# ======================================================
#  BACUSP v3.4 - Gestor Universal Multi-Entorno 🐢🌍
# ======================================================

ACCION=$1
PAQUETE=$2

# --- DETECCIÓN DE ENTORNO ---
detectar_gestor() {
    if command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)

# --- BARRA DE PROGRESO ANIMADA ---
animar_barra() {
    MENSAJE=$1
    echo "$MENSAJE"
    
    PASOS="10 30 55 80 100"
    for P in $PASOS; do
        BARRA=""
        LLENOS=$((P / 5))
        VACIOS=$((20 - LLENOS))
        
        i=0; while [ $i -lt $LLENOS ]; do BARRA="${BARRA}#"; i=$((i + 1)); done
        i=0; while [ $i -lt $VACIOS ]; do BARRA="${BARRA}."; i=$((i + 1)); done
        
        printf "\r[%s] %3d%% Procesando..." "$BARRA" "$P"
        sleep 0.12
    done
    echo ""
}

# --- FUNCIONES DE INSTALACIÓN Y GESTIÓN ---
instalar_paquete() {
    PKG=$1
    case "$ENTORNO" in
        ios)
            echo "📱 Verificando '$PKG'..."
            if command -v "$PKG" >/dev/null 2>&1; then
                echo "⚡ El comando '$PKG' ya está disponible."
            else
                animar_barra "🚀 Desempaquetando componentes..."
                if pkg install "$PKG"; then
                    echo "✅ ¡$PKG instalado con éxito!"
                else
                    echo "❌ Error: '$PKG' no existe en el repositorio."
                fi
            fi
            ;;
        debian)
            sudo apt-get update -y && sudo apt-get install -y "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        alpine)
            apk add --no-cache "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        arch)
            sudo pacman -S --noconfirm "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        fedora)
            sudo dnf install -y "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        *)
            echo "❌ Gestor no compatible."
            exit 1
            ;;
    esac
}

borrar_paquete() {
    PKG=$1
    case "$ENTORNO" in
        ios) pkg uninstall "$PKG" ;;
        debian) sudo apt-get remove -y "$PKG" ;;
        alpine) apk del "$PKG" ;;
        arch) sudo pacman -R --noconfirm "$PKG" ;;
        fedora) sudo dnf remove -y "$PKG" ;;
    esac
}

# --- ENRUTADOR DE COMANDOS MULTILINGÜE ---
case "$ACCION" in
    instalar|install|i)
        [ -z "$PAQUETE" ] && { echo "❌ Falta el paquete."; exit 1; }
        instalar_paquete "$PAQUETE"
        ;;

    borrar|remove|uninstall|rm)
        [ -z "$PAQUETE" ] && { echo "❌ Falta el paquete."; exit 1; }
        borrar_paquete "$PAQUETE"
        ;;

    actualizar|update|up)
        case "$ENTORNO" in
            ios) pkg update ;;
            debian) sudo apt-get update ;;
            alpine) apk update ;;
            arch) sudo pacman -Sy ;;
            fedora) sudo dnf check-update ;;
        esac
        ;;

    upgrade|self-update)
        RUTA_ACTUAL=$(pwd)
        REPO_DIR=""
        [ -d "$HOME/Documents/bacus-pkg/.git" ] && REPO_DIR="$HOME/Documents/bacus-pkg"
        
        if [ -n "$REPO_DIR" ]; then
            cd "$REPO_DIR" || exit
            git pull origin main
            cp bin/bacusp ~/Documents/bacusp
            chmod +x ~/Documents/bacusp
            cd "$RUTA_ACTUAL" || exit
            echo "✨ ¡Bacusp actualizado!"
        else
            echo "❌ No se encontró el repositorio local."
        fi
        ;;

    buscar|search|s)
        [ -z "$PAQUETE" ] && { echo "❌ Falta término de búsqueda."; exit 1; }
        case "$ENTORNO" in
            ios) pkg search "$PAQUETE" ;;
            debian) apt-cache search "$PAQUETE" | head -n 20 ;;
            alpine) apk search "$PAQUETE" ;;
            arch) pacman -Ss "$PAQUETE" ;;
            fedora) dnf search "$PAQUETE" ;;
        esac
        ;;

    listar|list|ls)
        case "$ENTORNO" in
            ios) pkg list ;;
            debian) dpkg -l | grep '^ii' | awk '{print $2}' | head -n 30 ;;
            alpine) apk info ;;
            arch) pacman -Qqe ;;
            fedora) dnf list installed | head -n 30 ;;
        esac
        ;;

    clean|limpiar|purge)
        SCRIPT_DIR=$(dirname "$0")
        if [ -f "$SCRIPT_DIR/../modules/clean.sh" ]; then
            sh "$SCRIPT_DIR/../modules/clean.sh"
        else
            rm -rf ~/.cache/* 2>/dev/null
            echo "✅ Caché limpia."
        fi
        ;;

    fetch|neofetch|info|sistema)
        SCRIPT_DIR=$(dirname "$0")
        if [ -f "$SCRIPT_DIR/../modules/fetch.sh" ]; then
            sh "$SCRIPT_DIR/../modules/fetch.sh"
        else
            echo "🐢 Bacusp v3.3 ($ENTORNO)"
        fi
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v3.3 - Gestor Universal"
        echo "Uso: bacusp <comando> [paquete]"
        echo ""
        echo "Comandos:"
        echo "  • instalar | install <pkg>  Instala un paquete"
        echo "  • borrar   | remove <pkg>   Elimina un paquete"
        echo "  • buscar   | search <kw>    Busca software"
        echo "  • listar   | list           Lista instalados"
        echo "  • update   | actualizar     Actualiza repos SO"
        echo "  • upgrade  | self-update    Actualiza Bacusp"
        echo "  • clean    | limpiar        Limpia la caché"
        echo "  • fetch    | info           Info del sistema"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'"
        ;;
esac
