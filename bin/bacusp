#!/bin/sh
# ======================================================
#  BACUSP v3.1 - Gestor Universal (Linux & iOS/a-shell) 🐢🌍
# ======================================================

ACCION=$1
PAQUETE=$2

# --- DETECCIÓN DE ENTORNO ---
detectar_gestor() {
    if command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)

# --- FUNCIONES DE INSTALACIÓN ---
instalar_paquete() {
    PKG=$1
    case "$ENTORNO" in
        ios)
            echo "📱 [Bacusp / a-shell] Verificando '$PKG'..."
            # Si el comando ya existe en a-shell
            if command -v "$PKG" >/dev/null 2>&1; then
                echo "⚡ '$PKG' ya está disponible de forma nativa en a-shell."
            else
                echo "📦 Intentando instalar '$PKG' vía pkg..."
                if pkg install "$PKG"; then
                    echo "✅ ¡$PKG instalado con éxito por Bacusp!"
                else
                    echo "❌ Error: '$PKG' no existe en el repo de pkg de a-shell."
                fi
            fi
            ;;
        debian)
            echo "🌀 [Bacusp / Debian] Instalando '$PKG' vía APT..."
            sudo apt-get update -y && sudo apt-get install -y "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        alpine)
            echo "🐧 [Bacusp / Alpine] Instalando '$PKG' vía apk..."
            apk add --no-cache "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        arch)
            echo "🏹 [Bacusp / Arch] Instalando '$PKG' vía pacman..."
            sudo pacman -S --noconfirm "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        fedora)
            echo "🎩 [Bacusp / Fedora] Instalando '$PKG' vía dnf..."
            sudo dnf install -y "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        *)
            echo "❌ No se encontró un gestor compatible en este sistema."
            exit 1
            ;;
    esac
}

# --- LÓGICA DE COMANDOS ---
case "$ACCION" in
    instalar|install)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá un paquete. Ejemplo: bacusp instalar git"
            exit 1
        fi
        instalar_paquete "$PAQUETE"
        ;;

    borrar|remove)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá el paquete a desinstalar."
            exit 1
        fi
        echo "🗑️ Desinstalando '$PAQUETE'..."
        case "$ENTORNO" in
            ios) pkg uninstall "$PAQUETE" ;;
            debian) sudo apt-get remove -y "$PAQUETE" ;;
            alpine) apk del "$PAQUETE" ;;
            arch) sudo pacman -R --noconfirm "$PAQUETE" ;;
            fedora) sudo dnf remove -y "$PAQUETE" ;;
        esac
        ;;

    actualizar|update)
        echo "🔄 Sincronizando repositorios ($ENTORNO)..."
        case "$ENTORNO" in
            ios) pkg update ;;
            debian) sudo apt-get update ;;
            alpine) apk update ;;
            arch) sudo pacman -Sy ;;
            fedora) sudo dnf check-update ;;
        esac
        ;;

    buscar|search)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá qué buscar."
            exit 1
        fi
        echo "🔍 Buscando '$PAQUETE'..."
        case "$ENTORNO" in
            ios) pkg search "$PAQUETE" ;;
            debian) apt-cache search "$PAQUETE" | head -n 20 ;;
            alpine) apk search "$PAQUETE" ;;
            arch) pacman -Ss "$PAQUETE" ;;
        esac
        ;;

    listar|list)
        echo "📋 Programas instalados (Entorno: $ENTORNO):"
        case "$ENTORNO" in
            ios) pkg list ;;
            debian) dpkg -l | grep '^ii' | awk '{print $2}' | head -n 30 ;;
            alpine) apk info ;;
            arch) pacman -Qqe ;;
        esac
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v3.1 - Gestor Universal (Linux & iOS)"
        echo "Uso: bacusp <comando> [paquete]"
        echo "Comandos: instalar, borrar, actualizar, buscar, listar"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'"
        ;;
esac
