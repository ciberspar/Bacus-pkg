#!/bin/bash
# ======================================================
#  BACUSP v1.2 - Gestor Multidistro Dinámico para chiquiOS 🐢
# ======================================================

ACCION=$1
PAQUETE=$2

REPO_USER="ciberspar"
REPO_NAME="bacus-pkg"
URL_CATALOGO="https://raw.githubusercontent.com/$REPO_USER/$REPO_NAME/main/paquetes.json"
CACHE_DIR="/var/cache/bacusp"
CATALOGO_LOCAL="$CACHE_DIR/paquetes.json"

mkdir -p "$CACHE_DIR" 2>/dev/null

# --- DETECTOR DE DISTRIBUCIÓN DE LINUX ---
instalar_segun_distro() {
    PKG=$1
    if command -v apk >/dev/null 2>&1; then
        echo "🐧 [chiquiOS/Alpine] Instalando $PKG vía apk..."
        apk add --no-cache "$PKG"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "🐧 [Debian/Ubuntu] Instalando $PKG vía apt..."
        sudo apt-get update && sudo apt-get install -y "$PKG"
    elif command -v pacman >/dev/null 2>&1; then
        echo "🐧 [Arch Linux] Instalando $PKG vía pacman..."
        sudo pacman -S --noconfirm "$PKG"
    elif command -v dnf >/dev/null 2>&1; then
        echo "🐧 [Fedora/RHEL] Instalando $PKG vía dnf..."
        sudo dnf install -y "$PKG"
    else
        echo "❌ No se encontró un gestor de paquetes soportado en este sistema."
        exit 1
    fi
}

borrar_segun_distro() {
    PKG=$1
    if command -v apk >/dev/null 2>&1; then
        apk del "$PKG"
    elif command -v apt-get >/dev/null 2>&1; then
        sudo apt-get remove -y "$PKG"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -R --noconfirm "$PKG"
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf remove -y "$PKG"
    fi
}

actualizar_catalogo() {
    echo "🔄 [Bacusp] Sincronizando catálogo remoto de $REPO_NAME..."
    if curl -sSL "$URL_CATALOGO" -o "$CATALOGO_LOCAL"; then
        echo "✅ Catálogo actualizado correctamente."
    else
        echo "❌ Error al conectar con GitHub para bajar el catálogo."
        exit 1
    fi
}

# --- LÓGICA DE COMANDOS BILINGÜES ---
case "$ACCION" in
    actualizar|update)
        actualizar_catalogo
        ;;

    buscar|search)
        if [ ! -f "$CATALOGO_LOCAL" ]; then
            actualizar_catalogo
        fi
        echo "🔍 Buscando aplicaciones disponibles en bacus-pkg:"
        grep -E '"(nombre|descripcion)"' "$CATALOGO_LOCAL" | sed 's/^[ \t]*//'
        ;;

    instalar|install)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Decime qué paquete querés instalar. Ejemplo: bacusp instalar nmap"
            exit 1
        fi

        if [ ! -f "$CATALOGO_LOCAL" ]; then
            actualizar_catalogo
        fi

        if grep -q "\"$PAQUETE\":" "$CATALOGO_LOCAL"; then
            echo "📦 Paquete '$PAQUETE' verificado en catálogo remoto."
            instalar_segun_distro "$PAQUETE"
            echo "✅ ¡$PAQUETE se instaló con éxito!"
        else
            echo "❌ El paquete '$PAQUETE' no figura en el catálogo remoto."
            echo "💡 Ejecutá 'bacusp buscar' o actualizá tu paquetes.json en GitHub."
            exit 1
        fi
        ;;

    borrar|remove)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Decime qué paquete querés desinstalar."
            exit 1
        fi
        echo "🗑️ Eliminando '$PAQUETE' del sistema..."
        borrar_segun_distro "$PAQUETE"
        echo "✅ Desinstalación completada."
        ;;

    listar|list)
        echo "📋 Aplicaciones instaladas en el sistema:"
        if command -v apk >/dev/null 2>&1; then
            apk info
        elif command -v apt-get >/dev/null 2>&1; then
            dpkg -l | grep '^ii' | awk '{print $2}' | head -n 30
        fi
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v1.2 Multi-Distro (chiquiOS Package Manager)"
        echo "Uso: bacusp <comando> [paquete]"
        echo ""
        echo "Comandos (ES/EN):"
        echo "  actualizar / update        Baja la versión más reciente del catálogo"
        echo "  buscar     / search        Muestra las apps del catálogo remoto"
        echo "  instalar   / install <pkg> Instala una app real detectando tu distro"
        echo "  borrar     / remove  <pkg> Borra la app del sistema"
        echo "  listar     / list          Lista los programas instalados"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'"
        echo "Usá 'bacusp ayuda' o 'bacusp help'."
        ;;
esac
