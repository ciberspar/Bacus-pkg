#!/bin/sh
# ======================================================
#  BACUSP v3.5 Pro - Gestor Universal Unificado 🐢🌍🧙‍♂️
# ======================================================

ACCION=$1
PAQUETE=$2
MODO_EXTRA=$3
MODO_VALOR=$4
LOG_FILE="$HOME/.bacusp_history.log"
SCRIPT_DIR=$(dirname "$0")

# --- DETECCIÓN DE ENTORNO ---
detectar_gestor() {
    if command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v winget >/dev/null 2>&1 || [ -n "$WINDIR" ]; then
        echo "windows"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)

# --- REGISTRAR EN HISTORIAL ---
registrar_log() {
    ACCION_LOG=$1
    PKG_LOG=$2
    FECHA=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "Fecha desconocida")
    echo "[$FECHA] Entorno: $ENTORNO | Acción: $ACCION_LOG | Paquete: $PKG_LOG" >> "$LOG_FILE"
}

# --- BARRA DE PROGRESO ANIMADA ---
animar_barra() {
    MENSAJE=$1
    echo "$MENSAJE"
    
    PASOS="10 30 55 80 100"
    for P in $PASOS; do
        BARRA=""
        LLENOS=$((P / 5))
        VACIOS=$((20 - LLENOS))
        
        i=0; while [ $i -lt $LLENOS ]; do BARRA="${BARRA}#"; i=$((i + 1)); done
        i=0; while [ $i -lt $VACIOS ]; do BARRA="${BARRA}."; i=$((i + 1)); done
        
        printf "\r[%s] %3d%% Procesando..." "$BARRA" "$P"
        sleep 0.06
    done
    echo ""
}

# --- ENRUTADOR PRINCIPAL ---
case "$ACCION" in
    instalar|install|i)
        [ -z "$PAQUETE" ] && { echo "❌ Falta especificar el paquete."; exit 1; }
        echo "📱 [Bacus Engine] Desplegando '$PAQUETE' en entorno: $ENTORNO..."
        animar_barra "🚀 Verificando dependencias y repositorios..."
        case "$ENTORNO" in
            ios) pkg install "$PAQUETE" ;;
            windows) winget install --id "$PAQUETE" -e --accept-source-agreements ;;
            debian) sudo apt-get install -y "$PAQUETE" ;;
            alpine) apk add --no-cache "$PAQUETE" ;;
            arch) sudo pacman -S --noconfirm "$PAQUETE" ;;
            fedora) sudo dnf install -y "$PAQUETE" ;;
        esac
        registrar_log "INSTALAR" "$PAQUETE"
        echo "✅ ¡$PAQUETE instalado con éxito!"
        ;;

    borrar|remove|uninstall|rm)
        [ -z "$PAQUETE" ] && { echo "❌ Falta especificar el paquete."; exit 1; }
        case "$ENTORNO" in
            ios) pkg uninstall "$PAQUETE" ;;
            windows) winget uninstall --id "$PAQUETE" ;;
            debian) sudo apt-get remove -y "$PAQUETE" ;;
            alpine) apk del "$PAQUETE" ;;
            arch) sudo pacman -R --noconfirm "$PAQUETE" ;;
            fedora) sudo dnf remove -y "$PAQUETE" ;;
        esac
        registrar_log "BORRAR" "$PAQUETE"
        echo "🗑️ Paquete $PAQUETE eliminado."
        ;;

    bridge|magia|magic)
        [ -z "$PAQUETE" ] && { echo "❌ Falta especificar el paquete para el puente mágico."; exit 1; }
        if [ -f "$SCRIPT_DIR/../modules/bridge.sh" ]; then
            sh "$SCRIPT_DIR/../modules/bridge.sh" "$PAQUETE"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/bridge.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/bridge.sh" "$PAQUETE"
        else
            echo "❌ Error: No se encuentra el módulo 'modules/bridge.sh'."
        fi
        registrar_log "MAGIA_NEGRA" "$PAQUETE"
        ;;

    fetch|neofetch|info|sistema)
        if [ -f "$SCRIPT_DIR/../modules/fetch.sh" ]; then
            sh "$SCRIPT_DIR/../modules/fetch.sh"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/fetch.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/fetch.sh"
        else
            echo "🐢 Bacusp v3.5 Pro ($ENTORNO)"
        fi
        ;;

    clean|limpiar|purge)
        if [ -f "$SCRIPT_DIR/../modules/clean.sh" ]; then
            sh "$SCRIPT_DIR/../modules/clean.sh"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/clean.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/clean.sh"
        else
            rm -rf ~/.cache/* 2>/dev/null
            echo "✅ Sistema purgado localmente."
        fi
        registrar_log "LIMPIAR" "sistema"
        ;;

    doctor|check)
        echo "🩺 [Bacus Engine] Diagnóstico integral del sistema:"
        echo "  • Entorno detectado: $ENTORNO"
        echo "  • Directorio bin: $SCRIPT_DIR"
        [ -f "$LOG_FILE" ] && echo "  • Historial de transacciones: Conectado ($LOG_FILE)" || echo "  • Historial: Vacío"
        [ -d "$SCRIPT_DIR/../modules" ] && echo "  • Módulos externos: Sincronizados OK"
        ;;

    history|log)
        if [ -f "$LOG_FILE" ]; then
            echo "📜 Registro de actividad reciente en Bacusp:"
            tail -n 25 "$LOG_FILE"
        else
            echo "📭 Todavía no hay registros en el historial."
        fi
        ;;

    upgrade|self-update)
        echo "🔄 Sincronizando Bacusp con el repositorio remoto..."
        RUTA_ACTUAL=$(pwd)
        REPO_DIR=""
        
        if [ -d "$HOME/Documents/bacus-pkg/.git" ]; then
            REPO_DIR="$HOME/Documents/bacus-pkg"
        elif [ -d "$HOME/Documents/bacus-pkg.git/.git" ]; then
            REPO_DIR="$HOME/Documents/bacus-pkg.git"
        fi

        if [ -n "$REPO_DIR" ]; then
            cd "$REPO_DIR" || exit
            if command -v lg2 >/dev/null 2>&1; then
                lg2 pull
            else
                git pull origin main
            fi
            
            if [ -f "bin/bacusp" ]; then
                cp bin/bacusp ~/Documents/bacusp
                chmod +x ~/Documents/bacusp
                cd "$RUTA_ACTUAL" || exit
                echo "✨ ¡Bacusp se ha actualizado correctamente en el sistema a v3.5 Pro!"
            else
                echo "❌ Error: No se encontró el binario en la ruta del repositorio."
                cd "$RUTA_ACTUAL" || exit
            fi
        else
            echo "❌ No se encontró la carpeta del repositorio Git local."
        fi
        ;;

    modo)
        if [ "$PAQUETE" = "apple" ] && [ "$MODO_EXTRA" = "yes" ]; then
            echo "🍎 [Bacus Sandbox Real] Inicializando aislamiento estricto de Kernel..."
            case "$ENTORNO" in
                debian|alpine|arch|fedora)
                    if command -v bwrap >/dev/null 2>&1; then
                        echo "🔒 Lanzando burbuja con Bubblewrap (bwrap)..."
                        bwrap --unshare-all --dev-bind / / --tmpfs /tmp --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 sh
                    elif command -v unshare >/dev/null 2>&1; then
                        echo "🔒 Lanzando aislamiento con namespaces (unshare)..."
                        unshare --fork --pid --mount-proc sh
                    else
                        echo "❌ Falta 'bubblewrap' en el sistema para habilitar el sandbox real."
                    fi
                    ;;
                ios)
                    echo "📱 [iOS] Ejecutando dentro del contenedor de a-shell."
                    sh
                    ;;
                windows)
                    echo "🪟 [Windows] Abriendo consola aislada..."
                    cmd
                    ;;
                *)
                    echo "❌ Entorno no compatible con sandbox de kernel."
                    ;;
            esac
        else
            echo "❌ Comando incorrecto. Probá con: bacusp modo apple yes"
        fi
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v3.5 Pro - Gestor Universal y Cross-Platform"
        echo "Uso: bacusp <comando> [argumento]"
        echo ""
        echo "Comandos principales:"
        echo "  • instalar <pkg>   Instala software nativo"
        echo "  • borrar <pkg>     Elimina un paquete"
        echo "  • bridge <pkg>     Aplica magia negra (Puente Linux/Windows)"
        echo "  • fetch            Muestra el banner interactivo y specs"
        echo "  • doctor           Diagnóstico del gestor"
        echo "  • history          Muestra el historial de comandos"
        echo "  • limpiar          Ejecuta limpieza profunda de caché"
        echo "  • upgrade          Actualiza Bacusp a la última versión desde GitHub"
        echo "  • modo apple yes   Activa el Sandbox Real de Kernel"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'. Escribí 'bacusp help' para ver la ayuda."
        ;;
esac
