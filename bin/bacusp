
#!/bin/sh
#
# BACUSP v7.5 - Modular Package Manager Frontend
# Project: Bacus-Pkg
# Author: ciberspar
# Target: ChiquiOS / POSIX-compatible environments
# Languages: Spanish / English
#

set -u
umask 077

VERSION="7.5"
APP="BACUSP"

# ---------- Colors ----------
if [ -t 1 ]; then
    GREEN=$(printf '\033[0;32m')
    CYAN=$(printf '\033[0;36m')
    RED=$(printf '\033[0;31m')
    YELLOW=$(printf '\033[0;33m')
    RESET=$(printf '\033[0m')
else
    GREEN=""
    CYAN=""
    RED=""
    YELLOW=""
    RESET=""
fi

# ---------- Paths ----------
HOME_DIR=${HOME:-/tmp}
BACUSP_HOME=${BACUSP_HOME:-"$HOME_DIR/.bacusp"}
CACHE_DIR="$BACUSP_HOME/cache"
LOG_FILE="$BACUSP_HOME/bacusp.log"
DB_FILE="$BACUSP_HOME/installed.db"

SCRIPT_DIR=$(
    CDPATH='' cd -P "$(dirname "$0")" 2>/dev/null &&
    pwd -P
) || {
    printf '%s\n' "BACUSP: cannot determine script directory." >&2
    exit 1
}

MODULE_DIR=${BACUSP_MODULE_DIR:-"$SCRIPT_DIR/../modules"}

if ! mkdir -p "$BACUSP_HOME" "$CACHE_DIR"; then
    printf '%s\n' "BACUSP: cannot create data directory." >&2
    exit 1
fi

# ---------- Messages ----------
info() {
    printf '%s%s%s\n' "$CYAN" "$*" "$RESET"
}

success() {
    printf '%s%s%s\n' "$GREEN" "$*" "$RESET"
}

warn() {
    printf '%s%s%s\n' "$YELLOW" "$*" "$RESET" >&2
}

error() {
    printf '%s%s%s\n' "$RED" "$*" "$RESET" >&2
}

# ---------- Logging ----------
log_msg() {
    timestamp=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '%s' unknown)
    printf '%s [%s] %s\n' "$timestamp" "$APP" "$*" \
        >> "$LOG_FILE" 2>/dev/null || :
}

# ---------- Platform detection ----------
detect_platform() {
    os_name=$(uname -s 2>/dev/null || printf '%s' unknown)

    case "$os_name" in
        Linux)
            if [ -n "${TERMUX_VERSION:-}" ] ||
               { [ -n "${PREFIX:-}" ] &&
                 [ -x "${PREFIX}/bin/pkg" ]; }; then
                printf '%s\n' termux
                return
            fi

            if [ -r /etc/os-release ]; then
                system_id=""
                system_like=""

                # shellcheck disable=SC1091
                . /etc/os-release

                system_id=${ID:-}
                system_like=${ID_LIKE:-}

                case "$system_id" in
                    debian) printf '%s\n' debian; return ;;
                    ubuntu) printf '%s\n' ubuntu; return ;;
                    arch) printf '%s\n' arch; return ;;
                    fedora) printf '%s\n' fedora; return ;;
                    opensuse*|suse)
                        printf '%s\n' opensuse
                        return
                        ;;
                    alpine) printf '%s\n' alpine; return ;;
                esac

                case " $system_like " in
                    *" debian "*)
                        printf '%s\n' debian-like
                        return
                        ;;
                    *" arch "*)
                        printf '%s\n' arch-like
                        return
                        ;;
                    *" fedora "*)
                        printf '%s\n' fedora-like
                        return
                        ;;
                esac
            fi

            printf '%s\n' linux-unknown
            ;;
        Darwin)  printf '%s\n' darwin ;;
        FreeBSD) printf '%s\n' freebsd ;;
        OpenBSD) printf '%s\n' openbsd ;;
        NetBSD)  printf '%s\n' netbsd ;;
        GNU)     printf '%s\n' hurd ;;
        Haiku)   printf '%s\n' haiku ;;
        *)       printf '%s\n' posix-unknown ;;
    esac
}

PLATFORM=$(detect_platform)

# ---------- Help ----------
show_help() {
    cat <<'EOF'
BACUSP - Bacus-Pkg
Gestor modular de paquetes / Modular package manager

USO / USAGE
  bacusp COMANDO [ARGUMENTOS]

PAQUETES / PACKAGES
  install ARCHIVO.bp       Instalar paquete BP / Install BP package
  install ARCHIVO.deb      Instalar paquete nativo / Install native package
  remove NOMBRE            Desinstalar / Remove
  purge NOMBRE             Eliminar datos / Purge
  list                     Listar instalados / List installed
  search TEXTO             Buscar paquetes / Search packages
  info NOMBRE              Información / Package information
  deps NOMBRE              Dependencias / Dependencies

REPOSITORIOS / REPOSITORIES
  repo list                Listar repositorios / List repositories
  repo add URL             Añadir repositorio / Add repository
  repo remove URL          Quitar repositorio / Remove repository

FORMATO BP / BP FORMAT
  convert ORIGEN [DESTINO.bp]  Convertir o empaquetar / Convert or package
  verify ARCHIVO.bp            Verificar estructura e integridad / Verify integrity
  bridge ARCHIVO [PLATAFORMA]  Analizar compatibilidad / Analyze compatibility

ACTUALIZACIONES / UPDATES
  update                   Centro de actualización / Update center
  upgrade                  Alias de update / Alias for update

TIENDA / STORE
  store                    Abrir tienda de terminal / Open terminal store
  tui                      Alias de store / Alias for store
  gui                      Abrir interfaz disponible / Open available interface

MANTENIMIENTO / MAINTENANCE
  clean                    Limpiar caché / Clean cache
  backup                   Crear respaldo / Create backup
  export                   Exportar datos / Export data
  optimize                 Optimizar datos / Optimize data
  doctor                   Diagnosticar / Diagnose
  audit                    Revisar registros / Review logs
  system                   Información del sistema / System information
  aliases                  Mostrar alias / Show aliases
  friends                  Comunidad / Community
  speedtest                Probar red / Test network

AYUDA / HELP
  help                     Mostrar ayuda / Show help
  version                  Versión y plataforma / Version and platform

SEGURIDAD / SECURITY
  verify comprueba estructura e integridad, no garantiza que
  un paquete sea seguro ni que esté libre de malware.

  verify checks structure and integrity; it does not guarantee
  that a package is safe or malware-free.

VARIABLES / ENVIRONMENT
  BACUSP_HOME
  BACUSP_MODULE_DIR
  BACUSPKG_BIN
  BACUSP_LANG
EOF
}

# ---------- System information ----------
show_system() {
    printf '\nBACUSP v%s\n' "$VERSION"
    printf '%s\n' '----------------------------------------'
    printf 'Platform / Plataforma: %s\n' "$PLATFORM"
    printf 'Architecture / Arquitectura: %s\n' \
        "$(uname -m 2>/dev/null || printf '%s' unknown)"
    printf 'Kernel / Núcleo: %s\n' \
        "$(uname -r 2>/dev/null || printf '%s' unknown)"
    printf 'Module directory / Módulos: %s\n' "$MODULE_DIR"
    printf 'Data directory / Datos: %s\n' "$BACUSP_HOME"
    printf 'Cache: %s\n' "$CACHE_DIR"
    printf 'Database / Base de datos: %s\n' "$DB_FILE"

    if [ -n "${BACUSPKG_BIN:-}" ]; then
        printf 'Engine override / Motor configurado: %s\n' "$BACUSPKG_BIN"
    else
        printf '%s\n' 'Engine / Motor: modular shell frontend'
    fi
}

# ---------- Module dispatcher ----------
run_module() {
    module=$1
    shift

    # Only fixed module names from the command router should reach here.
    case "$module" in
        install|remove|purge|list|search|info|deps|repo|update|convert|bridge|verify|doctor|audit|clean|backup|export|optimize|friends|aliases|speedtest|fetch|sysinfo|store_gui|store_tui|gui)
            ;;
        *)
            error "Invalid module name / Nombre de módulo inválido"
            return 2
            ;;
    esac

    module_file="$MODULE_DIR/$module.sh"

    if [ ! -f "$module_file" ] || [ ! -r "$module_file" ]; then
        error "Module not found or unreadable / Módulo no encontrado o ilegible: $module"
        warn "Expected path / Ruta esperada: $module_file"
        log_msg "Missing or unreadable module: $module"
        return 2
    fi

    log_msg "Running module=$module platform=$PLATFORM"

    # Modules execute in a separate shell process.
    sh "$module_file" "$@"
    result=$?

    if [ "$result" -eq 0 ]; then
        log_msg "Module completed: $module"
    else
        log_msg "Module failed: $module exit=$result"
    fi

    return "$result"
}

# ---------- Command router ----------
COMMAND=${1:-help}

case "$COMMAND" in
    help|ayuda|-h|--help)
        show_help
        ;;

    version|--version|-V)
        show_system
        ;;

    system|sistema|fetch|sysinfo)
        shift
        if [ -f "$MODULE_DIR/fetch.sh" ]; then
            run_module fetch "$@"
        elif [ -f "$MODULE_DIR/sysinfo.sh" ]; then
            run_module sysinfo "$@"
        else
            show_system
        fi
        ;;

    install|instalar|i)
        shift
        run_module install "$@"
        ;;

    remove|borrar|desinstalar|rm)
        shift
        run_module remove "$@"
        ;;

    purge|purgar)
        shift
        run_module purge "$@"
        ;;

    list|listar|ls)
        shift
        run_module list "$@"
        ;;

    search|buscar|s)
        shift
        run_module search "$@"
        ;;

    info|informacion|información|detalles)
        shift
        run_module info "$@"
        ;;

    deps|dependencias|depend)
        shift
        run_module deps "$@"
        ;;

    repo|repositorio|repos)
        shift
        run_module repo "$@"
        ;;

    update|upgrade|actualizar|actualizar-bacus|up)
        shift
        run_module update "$@"
        ;;

    convert|convertir|conv)
        shift
        run_module convert "$@"
        ;;

    bridge|puente)
        shift
        run_module bridge "$@"
        ;;

    verify|verificar|check)
        shift
        run_module verify "$@"
        ;;

    doctor|salud|diagnostico|diagnóstico)
        shift
        run_module doctor "$@"
        ;;

    audit|auditar|auditoria|auditoría)
        shift
        run_module audit "$@"
        ;;

    clean|limpiar|cleanup)
        shift
        run_module clean "$@"
        ;;

    backup|respaldo|copia)
        shift
        run_module backup "$@"
        ;;

    export|exportar)
        shift
        run_module export "$@"
        ;;

    optimize|optimizar)
        shift
        run_module optimize "$@"
        ;;

    friends|amigos|comunidad)
        shift
        run_module friends "$@"
        ;;

    aliases|alias|atajos)
        shift
        run_module aliases "$@"
        ;;

    gui|tui|store|tienda|tienda-gui|interfaz)
        shift

        # Prefer the original module name used in this repository.
        if [ -f "$MODULE_DIR/store_gui.sh" ]; then
            run_module store_gui "$@"
        elif [ -f "$MODULE_DIR/store_tui.sh" ]; then
            run_module store_tui "$@"
        elif [ -f "$MODULE_DIR/storegui.sh" ]; then
            run_module storegui "$@"
        elif [ -f "$MODULE_DIR/gui.sh" ]; then
            run_module gui "$@"
        else
            error "No package interface module is installed."
            error "No hay un módulo de tienda instalado."
            exit 2
        fi
        ;;

    speedtest|velocidad|test-red)
        shift
        run_module speedtest "$@"
        ;;

    nuke|nuke-native|destruir-nativo)
        error "This command is disabled / Este comando está deshabilitado."
        warn "Removing native package managers can break the operating system."
        warn "Eliminar gestores nativos puede dañar el sistema."
        log_msg "Blocked native package manager removal request"
        exit 2
        ;;

    *)
        error "Unknown command / Comando desconocido: $COMMAND"
        printf '%s\n' "Usá 'bacusp help' / Use 'bacusp help'."
        exit 2
        ;;
esac

exit $?
