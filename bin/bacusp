
#!/bin/sh
#
# BACUSP v6.0 - Modular Package Manager Frontend
# Project: Bacus-Pkg
# Author: ciberspar
# Target: ChiquiOS / POSIX-compatible environments
#
# BACUSP is the CLI frontend. Package operations must be
# implemented by Bacus-Pkg or a verified platform adapter.
#

set -u

VERSION="6.0"
APP="BACUSP"

# ---------- Colors ----------
if [ -t 1 ]; then
    VERDE=$(printf '\033[0;32m')
    AZUL=$(printf '\033[0;34m')
    CYAN=$(printf '\033[0;36m')
    ROJO=$(printf '\033[0;31m')
    AMARILLO=$(printf '\033[0;33m')
    RESET=$(printf '\033[0m')
else
    VERDE=""
    AZUL=""
    CYAN=""
    ROJO=""
    AMARILLO=""
    RESET=""
fi

# ---------- Paths ----------
BACUSP_HOME="${BACUSP_HOME:-${HOME:-/tmp}/.bacusp}"
CACHE_DIR="$BACUSP_HOME/cache"
LOG_FILE="$BACUSP_HOME/bacusp.log"
DB_FILE="$BACUSP_HOME/installed.db"

SCRIPT_DIR=$(
    CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null &&
    pwd -P
) || {
    printf '%s\n' "BACUSP: cannot determine script directory." >&2
    exit 1
}

MODULE_DIR="${BACUSP_MODULE_DIR:-$SCRIPT_DIR/../modules}"

mkdir -p "$BACUSP_HOME" "$CACHE_DIR" || {
    printf '%s\n' "BACUSP: cannot create its data directory." >&2
    exit 1
}

# ---------- Logging ----------
log_msg() {
    printf '%s [%s] %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown)" \
        "$APP" "$*" >> "$LOG_FILE" 2>/dev/null || :
}

info() {
    printf '%s%s%s\n' "$CYAN" "$*" "$RESET"
}

success() {
    printf '%s%s%s\n' "$VERDE" "$*" "$RESET"
}

warn() {
    printf '%s%s%s\n' "$AMARILLO" "$*" "$RESET" >&2
}

error() {
    printf '%s%s%s\n' "$ROJO" "$*" "$RESET" >&2
}

# ---------- Platform detection ----------
detectar_entorno() {
    OS_NAME=$(uname -s 2>/dev/null || printf unknown)
    OS_ARCH=$(uname -m 2>/dev/null || printf unknown)

    case "$OS_NAME" in
        Linux)
            if [ -r /etc/os-release ]; then
                # shellcheck disable=SC1091
                . /etc/os-release
                case "${ID:-}" in
                    debian)
                        printf 'debian'
                        return
                        ;;
                    ubuntu)
                        printf 'ubuntu'
                        return
                        ;;
                    arch)
                        printf 'arch'
                        return
                        ;;
                    fedora)
                        printf 'fedora'
                        return
                        ;;
                    opensuse*|opensuse)
                        printf 'opensuse'
                        return
                        ;;
                    alpine)
                        printf 'alpine'
                        return
                        ;;
                esac
            fi
            printf 'linux-unknown'
            ;;
        Darwin)
            printf 'darwin'
            ;;
        FreeBSD)
            printf 'freebsd'
            ;;
        OpenBSD)
            printf 'openbsd'
            ;;
        NetBSD)
            printf 'netbsd'
            ;;
        GNU)
            printf 'hurd'
            ;;
        Haiku)
            printf 'haiku'
            ;;
        *)
            if [ -n "${TERMUX_VERSION:-}" ]; then
                printf 'termux'
            else
                printf 'posix-unknown'
            fi
            ;;
    esac
}

ENTORNO=$(detectar_entorno)
ACCION=${1:-help}

# ---------- Bacus-Pkg engine ----------
# Optional explicit path to the Bacus-Pkg executable.
# No guessed command is executed if the engine is missing.
BACUSPKG_BIN="${BACUSPKG_BIN:-}"

encontrar_motor() {
    if [ -n "$BACUSPKG_BIN" ] && [ -x "$BACUSPKG_BIN" ]; then
        printf '%s\n' "$BACUSPKG_BIN"
        return 0
    fi

    for candidate in \
        "$SCRIPT_DIR/bacus-pkg" \
        "$SCRIPT_DIR/bacuspkg" \
        "$SCRIPT_DIR/../bacus-pkg/bin/bacus-pkg"
    do
        if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    command -v bacus-pkg 2>/dev/null && return 0
    return 1
}

# This deliberately does not guess Bacus-Pkg's CLI syntax.
# Connect each operation after confirming the engine's real interface.
motor_no_conectado() {
    error "Bacus-Pkg engine is not configured for this operation."
    warn "Detected platform: $ENTORNO"
    warn "No native package manager was invoked as a fallback."
    warn "Configure the verified Bacus-Pkg adapter before continuing."
    log_msg "Engine unavailable: action=$ACCION platform=$ENTORNO"
    return 2
}

# ---------- Module dispatcher ----------
ejecutar_modulo() {
    modulo=$1
    shift

    archivo="$MODULE_DIR/$modulo.sh"

    if [ ! -f "$archivo" ]; then
        error "Module not found: $archivo"
        log_msg "Missing module: $modulo"
        return 2
    fi

    if [ ! -r "$archivo" ]; then
        error "Module is not readable: $archivo"
        return 2
    fi

    log_msg "Running module=$modulo platform=$ENTORNO"

    # Modules receive the original remaining arguments.
    # They must validate arguments and report their real exit status.
    sh "$archivo" "$@"
    resultado=$?

    if [ "$resultado" -ne 0 ]; then
        log_msg "Module failed: $modulo exit=$resultado"
    fi

    return "$resultado"
}

# ---------- System information ----------
mostrar_sistema() {
    printf '%s\n' "BACUSP v$VERSION"
    printf 'Platform: %s\n' "$ENTORNO"
    printf 'Architecture: %s\n' \
        "$(uname -m 2>/dev/null || printf unknown)"
    printf 'Kernel: %s\n' \
        "$(uname -r 2>/dev/null || printf unknown)"
    printf 'Module directory: %s\n' "$MODULE_DIR"

    if motor=$(encontrar_motor); then
        printf 'Bacus-Pkg executable: %s\n' "$motor"
    else
        printf '%s\n' "Bacus-Pkg executable: not detected"
    fi
}

# ---------- Help ----------
mostrar_ayuda() {
    cat <<'EOF'
BACUSP v6.0 - Bacus-Pkg command frontend

Usage:
  bacusp COMMAND [ARGS...]

Package commands:
  install, instalar, i       Install a package
  remove, borrar, rm        Remove a package
  purge, purgar              Purge a package
  list, listar, ls           List installed packages
  search, buscar, s          Search packages
  info                       Show package details
  deps, dependencias         Inspect dependencies
  repo, repositorio          Manage repositories
  upgrade, actualizar, u     Request a system/package upgrade

System and maintenance:
  doctor, salud              Diagnose installation
  audit, auditar              Security audit
  clean, limpiar              Clean temporary cache
  backup                      Backup
  export, exportar             Export environment
  optimize, optimizar          Optimization module
  fetch, sysinfo               System information
  bridge                       Remote build bridge
  friends, amigos              Community repositories
  aliases, alias               Manage aliases
  gui, tui, store              Package interface
  speedtest, velocidad         Network speed test
  help, ayuda, h               Show this help
  version                      Show version and platform

Environment:
  BACUSP_HOME       BACUSP data directory
  BACUSP_MODULE_DIR Directory containing module scripts
  BACUSPKG_BIN      Explicit path to Bacus-Pkg executable

Safety:
  System upgrades require a verified engine and platform adapter.
  BACUSP never reports an upgrade as successful when it has not run.
  Missing adapters are errors, not permission to guess another backend.
EOF
}

# ---------- Command routing ----------
case "$ACCION" in
    help|ayuda|-h|--help|h)
        mostrar_ayuda
        ;;

    version|--version|-V)
        mostrar_sistema
        ;;

    system|sistema|fetch|sysinfo)
        if [ -f "$MODULE_DIR/fetch.sh" ]; then
            ejecutar_modulo fetch "$@"
        else
            mostrar_sistema
        fi
        ;;

    install|instalar|i)
        ejecutar_modulo install "$@"
        ;;

    remove|borrar|rm|desinstalar)
        ejecutar_modulo remove "$@"
        ;;

    purge|purgar)
        ejecutar_modulo purge "$@"
        ;;

    list|listar|ls)
        ejecutar_modulo list "$@"
        ;;

    search|buscar|s)
        ejecutar_modulo search "$@"
        ;;

    info)
        ejecutar_modulo info "$@"
        ;;

    deps|dependencias)
        ejecutar_modulo deps "$@"
        ;;

    repo|repositorio)
        ejecutar_modulo repo "$@"
        ;;

    upgrade|actualizar|u)
        ejecutar_modulo upgrade "$@"
        ;;

    doctor|salud)
        ejecutar_modulo doctor "$@"
        ;;

    audit|auditar)
        ejecutar_modulo audit "$@"
        ;;

    clean|limpiar)
        ejecutar_modulo clean "$@"
        ;;

    backup|respaldo)
        ejecutar_modulo backup "$@"
        ;;

    export|exportar)
        ejecutar_modulo export "$@"
        ;;

    optimize|optimizar)
        ejecutar_modulo optimize "$@"
        ;;

    bridge)
        ejecutar_modulo bridge "$@"
        ;;

    friends|amigos)
        ejecutar_modulo friends "$@"
        ;;

    aliases|alias|atajos)
        ejecutar_modulo aliases "$@"
        ;;

    gui|tui|store|tienda-gui)
        if [ -f "$MODULE_DIR/storegui.sh" ]; then
            ejecutar_modulo storegui "$@"
        elif [ -f "$MODULE_DIR/gui.sh" ]; then
            ejecutar_modulo gui "$@"
        else
            error "No package interface module is installed."
            exit 2
        fi
        ;;

    speedtest|velocidad)
        ejecutar_modulo speedtest "$@"
        ;;

    nuke-native|destruir-nativo|nuke)
        error "This command is disabled in BACUSP v6.0."
        warn "Removing native package-management components can break the OS."
        warn "Use a tested migration plan before replacing system package tools."
        log_msg "Blocked unsafe native package manager removal request"
        exit 2
        ;;

    *)
        error "Unknown command: $ACCION"
        printf '%s\n' "Run 'bacusp help' to see available commands."
        exit 2
        ;;
esac

exit $?
