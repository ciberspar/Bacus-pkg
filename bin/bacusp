#!/bin/sh
# ======================================================
#  BACUSP v3.10 - Gestor Universal y Bilingüe 🐢🌍🧙‍♂️
# ======================================================

ACCION=$1
PAQUETE=$2
MODO_EXTRA=$3
MODO_VALOR=$4
LOG_FILE="$HOME/.bacusp_history.log"
SCRIPT_DIR=$(dirname "$0")

# --- DETECCIÓN DE ENTORNO ---
detectar_gestor() {
    if command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v winget >/dev/null 2>&1 || [ -n "$WINDIR" ]; then
        echo "windows"
    elif command -v pkgman >/dev/null 2>&1; then
        echo "haiku"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)

# --- REGISTRAR EN HISTORIAL ---
registrar_log() {
    ACCION_LOG=$1
    PKG_LOG=$2
    FECHA=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "Fecha desconocida")
    echo "[$FECHA] Entorno: $ENTORNO | Acción: $ACCION_LOG | Paquete: $PKG_LOG" >> "$LOG_FILE"
}

# --- BARRA DE PROGRESO ANIMADA ---
animar_barra() {
    MENSAJE=$1
    echo "$MENSAJE"
    
    PASOS="10 30 55 80 100"
    for P in $PASOS; do
        BARRA=""
        LLENOS=$((P / 5))
        VACIOS=$((20 - LLENOS))
        
        i=0; while [ $i -lt $LLENOS ]; do BARRA="${BARRA}#"; i=$((i + 1)); done
        i=0; while [ $i -lt $VACIOS ]; do BARRA="${BARRA}."; i=$((i + 1)); done
        
        printf "\r[%s] %3d%% Procesando..." "$BARRA" "$P"
        sleep 0.06
    done
    echo ""
}

# --- ENRUTADOR PRINCIPAL ---
case "$ACCION" in
    instalar|install|i)
        [ -z "$PAQUETE" ] && { echo "❌ Falta especificar el paquete / Missing package."; exit 1; }
        echo "📱 [Bacus Engine] Desplegando '$PAQUETE' en entorno / environment: $ENTORNO..."
        animar_barra "🚀 Verificando dependencias y repositorios..."
        case "$ENTORNO" in
            ios) pkg install "$PAQUETE" ;;
            windows) winget install --id "$PAQUETE" -e --accept-source-agreements ;;
            haiku) pkgman install "$PAQUETE" ;;
            debian) sudo apt-get install -y "$PAQUETE" ;;
            alpine) apk add --no-cache "$PAQUETE" ;;
            arch) sudo pacman -S --noconfirm "$PAQUETE" ;;
            fedora) sudo dnf install -y "$PAQUETE" ;;
        esac
        registrar_log "INSTALAR" "$PAQUETE"
        echo "✅ ¡$PAQUETE instalado con éxito! / Successfully installed!"
        ;;

    borrar|remove|uninstall|rm)
        [ -z "$PAQUETE" ] && { echo "❌ Falta especificar el paquete / Missing package."; exit 1; }
        case "$ENTORNO" in
            ios) pkg uninstall "$PAQUETE" ;;
            windows) winget uninstall --id "$PAQUETE" ;;
            debian) sudo apt-get remove -y "$PAQUETE" ;;
            alpine) apk del "$PAQUETE" ;;
            arch) sudo pacman -R --noconfirm "$PAQUETE" ;;
            fedora) sudo dnf remove -y "$PAQUETE" ;;
        esac
        registrar_log "BORRAR" "$PAQUETE"
        echo "🗑️ Paquete $PAQUETE eliminado / removed."
        ;;

    bridge|magia|magic)
        [ -z "$PAQUETE" ] && { echo "❌ Falta especificar el paquete para el puente mágico."; exit 1; }
        if [ -f "$SCRIPT_DIR/../modules/bridge.sh" ]; then
            sh "$SCRIPT_DIR/../modules/bridge.sh" "$PAQUETE"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/bridge.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/bridge.sh" "$PAQUETE"
        else
            echo "❌ Error: No se encuentra el módulo 'modules/bridge.sh'."
        fi
        registrar_log "MAGIA_NEGRA" "$PAQUETE"
        ;;

    fetch|neofetch|info|sistema)
        if [ -f "$SCRIPT_DIR/../modules/fetch.sh" ]; then
            sh "$SCRIPT_DIR/../modules/fetch.sh"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/fetch.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/fetch.sh"
        else
            echo "🐢 Bacusp v3.5 Pro ($ENTORNO)"
        fi
        ;;

    clean|limpiar|purge)
        if [ -f "$SCRIPT_DIR/../modules/clean.sh" ]; then
            sh "$SCRIPT_DIR/../modules/clean.sh"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/clean.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/clean.sh"
        else
            rm -rf ~/.cache/* 2>/dev/null
            echo "✅ Sistema purgado localmente / System cleaned."
        fi
        registrar_log "LIMPIAR" "sistema"
        ;;

    doctor|check)
        echo "🩺 [Bacus Engine] Diagnóstico integral / System Diagnostic:"
        echo "  • Entorno / Environment: $ENTORNO"
        echo "  • Directorio / Path: $SCRIPT_DIR"
        [ -f "$LOG_FILE" ] && echo "  • Historial / History: Conectado ($LOG_FILE)" || echo "  • Historial: Vacío"
        [ -d "$SCRIPT_DIR/../modules" ] && echo "  • Módulos externos / External modules: OK"
        ;;

    history|log)
        if [ -f "$LOG_FILE" ]; then
            echo "📜 Registro de actividad reciente en Bacusp / Activity log:"
            tail -n 25 "$LOG_FILE"
        else
            echo "📭 Todavía no hay registros en el historial."
        fi
        ;;

    upgrade|self-update)
        echo "🔄 Descargando la última versión de Bacusp v3.5 Pro desde GitHub..."
        URL_RAW="https://raw.githubusercontent.com/ciberspar/bacus-pkg/main/bin/bacusp"
        
        if command -v curl >/dev/null 2>&1; then
            curl -sSL "$URL_RAW" -o "$HOME/Documents/bacusp"
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "$HOME/Documents/bacusp" "$URL_RAW"
        else
            echo "❌ Error: Se necesita curl o wget para actualizar."
            exit 1
        fi
        
        if [ -f "$HOME/Documents/bacusp" ]; then
            chmod +x "$HOME/Documents/bacusp"
            echo "✨ ¡Bacusp se ha actualizado a la versión v3.5 Pro con éxito en el sistema!"
        else
            echo "❌ Error al actualizar el binario."
        fi
        ;;

    modo)
        if [ "$PAQUETE" = "apple" ] && [ "$MODO_EXTRA" = "yes" ]; then
            echo "🍎 [Bacus Sandbox Real] Inicializando aislamiento estricto de Kernel..."
            case "$ENTORNO" in
                debian|alpine|arch|fedora)
                    if command -v bwrap >/dev/null 2>&1; then
                        echo "🔒 Lanzando burbuja con Bubblewrap (bwrap)..."
                        bwrap --unshare-all --dev-bind / / --tmpfs /tmp --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 sh
                    elif command -v unshare >/dev/null 2>&1; then
                        echo "🔒 Lanzando aislamiento con namespaces (unshare)..."
                        unshare --fork --pid --mount-proc sh
                    else
                        echo "❌ Falta 'bubblewrap' en el sistema para habilitar el sandbox real."
                    fi
                    ;;
                ios)
                    echo "📱 [iOS] Ejecutando dentro del contenedor de a-shell."
                    sh
                    ;;
                windows)
                    echo "🪟 [Windows] Abriendo consola aislada..."
                    cmd
                    ;;
                *)
                    echo "❌ Entorno no compatible con sandbox de kernel."
                    ;;
            esac
        else
            echo "❌ Comando incorrecto. Probá con: bacusp modo apple yes"
        fi
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v3.5 Pro - Gestor Universal (Linux, Windows & iOS)"
        echo "Uso / Usage: bacusp <comando / command> [paquete / package]"
        echo ""
        echo "Comandos soportados (Soporte Bilingüe / Bilingual Support):"
        echo "  • instalar / install <pkg>     : Instala un paquete con barra de progreso"
        echo "  • borrar / remove <pkg>        : Desinstala un paquete"
        echo "  • bridge / magia <pkg>         : Aplica magia negra (Puente Linux/Windows)"
        echo "  • fetch / info                 : Muestra el logo y datos de la distro/iOS"
        echo "  • doctor / check               : Diagnóstico integral del gestor"
        echo "  • history / log                : Muestra el historial de comandos"
        echo "  • limpiar / clean              : Borra cachés y temporales"
        echo "  • upgrade / self-update        : Actualiza Bacusp a la última versión desde GitHub"
        echo "  • modo apple yes               : Activa el Sandbox Real de Kernel"
        ;;

    *)
        echo "❌ Comando desconocido / Unknown command: '$ACCION'. Escribí 'bacusp ayuda' para ver los comandos."
        ;;
esac
