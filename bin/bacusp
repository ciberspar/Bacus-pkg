#!/bin/sh
# ======================================================
#  BACUSP v3.2 - Gestor Universal con Barra & Clean 🐢🌍
# ======================================================

ACCION=$1
PAQUETE=$2

# --- DETECCIÓN DE ENTORNO ---
detectar_gestor() {
    if command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)

# --- BARRA DE PROGRESO TIPO APT ---
animar_barra() {
    MENSAJE=$1
    echo "$MENSAJE"
    
    # Simulación de pasos de instalación al estilo APT
    PASOS="10 30 55 80 100"
    for P in $PASOS; do
        BARRA=""
        LLENOS=$((P / 5))
        VACIOS=$((20 - LLENOS))
        
        i=0; while [ $i -lt $LLENOS ]; do BARRA="${BARRA}#"; i=$((i + 1)); done
        i=0; while [ $i -lt $VACIOS ]; do BARRA="${BARRA}."; i=$((i + 1)); done
        
        printf "\r[%s] %3d%% Cargando componentes..." "$BARRA" "$P"
        sleep 0.15
    done
    echo ""
}

# --- FUNCIONES DE INSTALACIÓN ---
instalar_paquete() {
    PKG=$1
    case "$ENTORNO" in
        ios)
            echo "📱 [Bacusp / a-shell] Analizando '$PKG' y dependencias..."
            if command -v "$PKG" >/dev/null 2>&1; then
                echo "⚡ El comando '$PKG' ya se encuentra disponible de forma nativa en a-shell."
            else
                echo "📦 Preparando árbol de librerías para '$PKG':"
                echo "   ├── $PKG (paquete principal)"
                echo "   └── libwasm-$PKG.a (runtime WebAssembly)"
                
                animar_barra "🚀 Desempaquetando e instalando componentes en iOS..."
                
                if pkg install "$PKG"; then
                    echo "✅ ¡Librerías y binarios de '$PKG' instalados correctamente por Bacusp!"
                else
                    echo "❌ Error: '$PKG' no se encuentra en el repositorio de pkg de a-shell."
                fi
            fi
            ;;
        debian)
            echo "🌀 [Bacusp / Debian] Leyendo lista de paquetes y librerías..."
            sudo apt-get update -y
            sudo apt-get install -y "$PKG" && echo "✅ ¡$PKG y sus librerías asociadas han sido instalados!"
            ;;
        alpine)
            echo "🐧 [Bacusp / Alpine] Instalando '$PKG' vía apk..."
            apk add --no-cache "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        arch)
            echo "🏹 [Bacusp / Arch] Resolviendo dependencias para '$PKG'..."
            sudo pacman -S --noconfirm "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        fedora)
            echo "🎩 [Bacusp / Fedora] Instalando '$PKG'..."
            sudo dnf install -y "$PKG" && echo "✅ ¡$PKG instalado!"
            ;;
        *)
            echo "❌ No se encontró un gestor compatible en este sistema."
            exit 1
            ;;
    esac
}

# --- LÓGICA DE COMANDOS ---
case "$ACCION" in
    instalar|install)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá un paquete. Ejemplo: bacusp instalar git"
            exit 1
        fi
        instalar_paquete "$PAQUETE"
        ;;

    borrar|remove)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá el paquete a desinstalar."
            exit 1
        fi
        echo "🗑️ Desinstalando '$PAQUETE' y desvinculando dependencias..."
        case "$ENTORNO" in
            ios) pkg uninstall "$PAQUETE" ;;
            debian) sudo apt-get remove -y "$PAQUETE" ;;
            alpine) apk del "$PAQUETE" ;;
            arch) sudo pacman -R --noconfirm "$PAQUETE" ;;
            fedora) sudo dnf remove -y "$PAQUETE" ;;
        esac
        ;;

    actualizar|update)
        echo "🔄 Sincronizando repositorios ($ENTORNO)..."
        case "$ENTORNO" in
            ios) pkg update ;;
            debian) sudo apt-get update ;;
            alpine) apk update ;;
            arch) sudo pacman -Sy ;;
            fedora) sudo dnf check-update ;;
        esac
        ;;

    buscar|search)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá qué buscar."
            exit 1
        fi
        echo "🔍 Buscando '$PAQUETE'..."
        case "$ENTORNO" in
            ios) pkg search "$PAQUETE" ;;
            debian) apt-cache search "$PAQUETE" | head -n 20 ;;
            alpine) apk search "$PAQUETE" ;;
            arch) pacman -Ss "$PAQUETE" ;;
        esac
        ;;

    listar|list)
        echo "📋 Programas instalados (Entorno: $ENTORNO):"
        case "$ENTORNO" in
            ios) pkg list ;;
            debian) dpkg -l | grep '^ii' | awk '{print $2}' | head -n 30 ;;
            alpine) apk info ;;
            arch) pacman -Qqe ;;
        esac
        ;;

    clean|limpiar)
        SCRIPT_DIR=$(dirname "$0")
        if [ -f "$SCRIPT_DIR/../modules/clean.sh" ]; then
            sh "$SCRIPT_DIR/../modules/clean.sh"
        elif [ -f "$HOME/Documents/a-Shell/bacus-pkg/modules/clean.sh" ]; then
            sh "$HOME/Documents/a-Shell/bacus-pkg/modules/clean.sh"
        else
            echo "🧹 Limpiando temporales directamente..."
            rm -rf ~/.cache/* 2>/dev/null
            echo "✅ Caché eliminada."
        fi
        ;;

    info)
        SCRIPT_DIR=$(dirname "$0")
        if [ -f "$SCRIPT_DIR/../modules/info.sh" ]; then
            sh "$SCRIPT_DIR/../modules/info.sh"
        else
            echo "ℹ️ Bacusp v3.2 corriendo en $ENTORNO"
        fi
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v3.2 - Gestor Universal (Linux & iOS)"
        echo "Uso: bacusp <comando> [paquete]"
        echo "Comandos: instalar, borrar, actualizar, buscar, listar, clean, info"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'"
        ;;
esac
