#!/bin/bash
# ======================================================
#  BACUSP v2.0 - Gestor Universal con Repos de la Comunidad 🐢
# ======================================================

ACCION=$1
PAQUETE=$2

# --- INSTALADOR USANDO REPOS GLOBALES Y DE LA COMUNIDAD ---
instalar_desde_comunidad() {
    PKG=$1
    echo "🔍 [Bacusp] Buscando '$PKG' en los repositorios oficiales y de la comunidad..."
    
    if command -v apk >/dev/null 2>&1; then
        echo "🐧 [Alpine / chiquiOS] Consultando repos main & community..."
        apk add --no-cache "$PKG"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "🐧 [Debian / Ubuntu] Consultando repos oficiales y universe..."
        sudo apt-get update && sudo apt-get install -y "$PKG"
    elif command -v pacman >/dev/null 2>&1; then
        echo "🐧 [Arch Linux] Consultando repos Core, Extra & AUR..."
        sudo pacman -S --noconfirm "$PKG"
    elif command -v dnf >/dev/null 2>&1; then
        echo "🐧 [Fedora / RHEL] Consultando repos de la comunidad..."
        sudo dnf install -y "$PKG"
    else
        echo "❌ No se encontró un gestor de paquetes compatible en este sistema."
        exit 1
    fi
}

borrar_paquete() {
    PKG=$1
    if command -v apk >/dev/null 2>&1; then
        apk del "$PKG"
    elif command -v apt-get >/dev/null 2>&1; then
        sudo apt-get remove -y "$PKG"
    elif command -v pacman >/dev/null 2>&1; then
        sudo pacman -R --noconfirm "$PKG"
    elif command -v dnf >/dev/null 2>&1; then
        sudo dnf remove -y "$PKG"
    fi
}

# --- LÓGICA DE COMANDOS ---
case "$ACCION" in
    instalar|install)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá un paquete. Ejemplo: bacusp instalar firefox"
            exit 1
        fi
        instalar_comunidad "$PAQUETE"
        echo "✅ ¡$PAQUETE procesado con éxito por Bacusp!"
        ;;

    borrar|remove)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá el paquete a borrar."
            exit 1
        fi
        echo "🗑️ Desinstalando '$PAQUETE'..."
        borrar_paquete "$PAQUETE"
        echo "✅ Paquete removido."
        ;;

    actualizar|update)
        echo "🔄 Sincronizando listas de los repositorios de la comunidad..."
        if command -v apk >/dev/null 2>&1; then
            apk update
        elif command -v apt-get >/dev/null 2>&1; then
            sudo apt-get update
        elif command -v pacman >/dev/null 2>&1; then
            sudo pacman -Sy
        fi
        echo "✅ Repositorios sincronizados."
        ;;

    listar|list)
        echo "📋 Programas instalados en el sistema:"
        if command -v apk >/dev/null 2>&1; then
            apk info
        elif command -v apt-get >/dev/null 2>&1; then
            dpkg -l | grep '^ii' | awk '{print $2}' | head -n 35
        fi
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v2.0 - chiquiOS Package Manager"
        echo "Uso: bacusp <comando> [paquete]"
        echo ""
        echo "Comandos (ES/EN):"
        echo "  actualizar / update        Actualiza las listas de los repos globales"
        echo "  instalar   / install <pkg> Instala cualquier app desde la comunidad"
        echo "  borrar     / remove  <pkg> Desinstala una aplicación"
        echo "  listar     / list          Muestra las apps instaladas"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'"
        echo "Usá 'bacusp ayuda' para ver las opciones disponibles."
        ;;
esac
