#!/bin/sh
# ======================================================
#  BACUSP v3.15 - Universal Dynamic Package Manager 🐢🚀
#  Creador: ciberspar
# ======================================================

# Colores ANSI
VERDE='\033[1;32m'
AZUL='\033[1;34m'
CYAN='\033[1;36m'
ROJO='\033[1;31m'
MAGENTA='\033[1;35m'
AMARILLO='\033[1;33m'
RESET='\033[0m'

# --- 1. FUNCIÓN DE DETECCIÓN DE ENTORNO EXHAUSTIVA ---
detectar_gestor() {
    if uname -r | grep -qi "hurd"; then
        echo "hurd"
    elif command -v pkgin >/dev/null 2>&1; then
        echo "minix"
    elif [ -d "/usr/Serenity" ] || uname -s | grep -qi "Serenity"; then
        echo "serenity"
    elif [ -d "/net" ] && uname -s | grep -qi "Plan9"; then
        echo "plan9"
    elif command -v pkg >/dev/null 2>&1 && [ -d "/data/data/com.termux" ]; then
        echo "termux"
    elif command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v winget >/dev/null 2>&1 || [ -n "$WINDIR" ]; then
        echo "windows"
    elif command -v pkgman >/dev/null 2>&1; then
        echo "haiku"
    elif command -v pkg_add >/dev/null 2>&1; then
        echo "bsd"
    elif command -v zypper >/dev/null 2>&1; then
        echo "opensuse"
    elif uname -s | grep -qi "SunOS"; then
        echo "solaris"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)
ACCION=$1
PAQUETE=$2

# --- 2. BUSCADOR DINÁMICO EN REPOS NATIVOS ---
buscar_paquete_dinamico() {
    QUERY=$1
    ENTORNO_ACTUAL=$2

    case "$ENTORNO_ACTUAL" in
        debian|ubuntu|hurd)
            apt-cache search "$QUERY" 2>/dev/null | head -n 1 | awk '{print $1}'
            ;;
        arch)
            pacman -Ssq "$QUERY" 2>/dev/null | head -n 1
            ;;
        fedora)
            dnf search "$QUERY" 2>/dev/null | grep -v "^=" | awk '{print $1}' | head -n 1
            ;;
        opensuse)
            zypper search "$QUERY" 2>/dev/null | grep -i "$QUERY" | head -n 1 | awk -F'|' '{print $2}' | xargs
            ;;
        haiku)
            pkgman search "$QUERY" 2>/dev/null | grep -i "$QUERY" | head -n 1 | awk '{print $1}'
            ;;
        windows)
            winget search "$QUERY" --accept-source-agreements 2>/dev/null | grep -i "$QUERY" | head -n 1 | awk '{print $NF}'
            ;;
        bsd)
            pkg search "$QUERY" 2>/dev/null | head -n 1 | awk '{print $1}'
            ;;
        termux|ios)
            pkg search "$QUERY" 2>/dev/null | head -n 1 | awk '{print $1}'
            ;;
        *)
            echo "$QUERY"
            ;;
    esac
}

# --- 3. BÚSQUEDA DINÁMICA DE CÓDIGO FUENTE (GITHUB FALLBACK) ---
buscar_fuente_github() {
    REPO_NAME=$1
    echo "${AMARILLO}🔍 [Bridge Engine] Buscando código fuente dinámico para: '$REPO_NAME'...${RESET}"
    
    URL_REPO=$(curl -s "https://api.github.com/search/repositories?q=$REPO_NAME" | grep '"clone_url":' | head -n 1 | awk -F'"' '{print $4}')
    
    if [ -n "$URL_REPO" ]; then
        echo "${VERDE}📥 Clonando desde repositorio remoto: $URL_REPO${RESET}"
        DIR_TEMP="/tmp/bacus_$REPO_NAME"
        rm -rf "$DIR_TEMP"
        git clone --depth 1 "$URL_REPO" "$DIR_TEMP"
        
        if [ -d "$DIR_TEMP" ]; then
            cd "$DIR_TEMP" || exit
            echo "${CYAN}⚙️ Intentando compilación automática nativa...${RESET}"
            if [ -f "configure" ]; then
                ./configure && make && sudo make install
            elif [ -f "Makefile" ] || [ -f "makefile" ]; then
                make && sudo make install
            elif [ -f "CMakeLists.txt" ]; then
                mkdir -p build && cd build && cmake .. && make && sudo make install
            elif [ -f "setup.py" ]; then
                python3 setup.py install
            else
                echo "${AMARILLO}⚠️ No se detectó un sistema de compilación estándar. Archivos listos en $DIR_TEMP${RESET}"
            fi
        fi
    else
        echo "${ROJO}❌ No se encontró código fuente en repositorios remotos para '$REPO_NAME'.${RESET}"
    fi
}

# --- 4. MENÚ DE AYUDA BILINGÜE ---
mostrar_ayuda() {
    echo ""
    echo "${CYAN}======================================================${RESET}"
    echo "${VERDE}  🐢 BACUSP v3.15 - Universal Package Manager${RESET}"
    echo "${CYAN}======================================================${RESET}"
    echo "  Uso / Usage:"
    echo "    bacusp install <paquete>   - Búsqueda, traducción e instalación"
    echo "    bacusp remove <paquete>    - Borra o desinstala un paquete"
    echo "    bacusp fetch               - Muestra specs y entorno con estilo"
    echo "    bacusp help                - Muestra esta ayuda"
    echo ""
    echo "  Entorno detectado / Detected OS: ${AMARILLO}$ENTORNO${RESET}"
    echo "${CYAN}======================================================${RESET}"
    echo ""
}

# --- 5. ENRUTADOR PRINCIPAL ---
case "$ACCION" in
    install|instalar|i)
        [ -z "$PAQUETE" ] && { echo "${ROJO}❌ Error: Especificá un paquete para instalar.${RESET}"; exit 1; }
        
        echo "${CYAN}🚀 [Bacusp v3.15] Buscando en tiempo real para: '$PAQUETE' en [$ENTORNO]...${RESET}"
        
        # Intentar resolver el nombre en el repo nativo del SO
        PAQUETE_RESUELTO=$(buscar_paquete_dinamico "$PAQUETE" "$ENTORNO")

        if [ -n "$PAQUETE_RESUELTO" ]; then
            echo "${VERDE}✨ Coincidencia exacta encontrada en repo nativo: '$PAQUETE_RESUELTO'${RESET}"
            
            case "$ENTORNO" in
                debian|ubuntu|hurd) sudo apt-get update && sudo apt-get install -y "$PAQUETE_RESUELTO" ;;
                arch) sudo pacman -S --noconfirm "$PAQUETE_RESUELTO" ;;
                alpine) apk add --no-cache "$PAQUETE_RESUELTO" ;;
                fedora) sudo dnf install -y "$PAQUETE_RESUELTO" ;;
                opensuse) sudo zypper install -y "$PAQUETE_RESUELTO" ;;
                termux|ios) pkg install -y "$PAQUETE_RESUELTO" ;;
                haiku) pkgman install -y "$PAQUETE_RESUELTO" ;;
                bsd) sudo pkg install -y "$PAQUETE_RESUELTO" || pkg_add "$PAQUETE_RESUELTO" ;;
                windows) winget install --id "$PAQUETE_RESUELTO" --silent ;;
                solaris|minix) pkg install "$PAQUETE_RESUELTO" || pkgin install "$PAQUETE_RESUELTO" ;;
                *) echo "⚠️ Instalando directamente..." ;;
            esac
        else
            echo "${AMARILLO}⚠️ No está en el repo nativo. Activando Bridge de código fuente (GitHub)...${RESET}"
            buscar_fuente_github "$PAQUETE"
        fi
        ;;

    remove|borrar|rm)
        [ -z "$PAQUETE" ] && { echo "${ROJO}❌ Error: Especificá un paquete para borrar.${RESET}"; exit 1; }
        
        echo "${ROJO}🗑️ [Bacusp] Desinstalando '$PAQUETE' en [$ENTORNO]...${RESET}"
        case "$ENTORNO" in
            debian|ubuntu|hurd) sudo apt-get remove -y "$PAQUETE" ;;
            arch) sudo pacman -R --noconfirm "$PAQUETE" ;;
            alpine) apk del "$PAQUETE" ;;
            fedora) sudo dnf remove -y "$PAQUETE" ;;
            opensuse) sudo zypper remove -y "$PAQUETE" ;;
            termux|ios) pkg uninstall "$PAQUETE" ;;
            haiku) pkgman uninstall "$PAQUETE" ;;
            bsd) sudo pkg delete -y "$PAQUETE" || pkg_delete "$PAQUETE" ;;
            windows) winget uninstall --id "$PAQUETE" ;;
            solaris|minix) pkg uninstall "$PAQUETE" || pkgin remove "$PAQUETE" ;;
            *) echo "⚠️ Desinstalación manual requerida." ;;
        esac
        ;;

    fetch|info)
        if [ -f "$(dirname "$0")/../modules/fetch.sh" ]; then
            sh "$(dirname "$0")/../modules/fetch.sh"
        elif [ -f "$HOME/Documents/bacus-pkg/modules/fetch.sh" ]; then
            sh "$HOME/Documents/bacus-pkg/modules/fetch.sh"
        else
            echo "${VERDE}🐢 Bacusp v3.15 - Entorno: $ENTORNO${RESET}"
        fi
        ;;

    help|ayuda|*)
        mostrar_ayuda
        ;;
esac
