#!/bin/sh
# ======================================================
#  BACUSP v3.0 - Gestor Universal (Linux & iOS/a-shell) 🐢🌍
# ======================================================

ACCION=$1
PAQUETE=$2

# --- DETECCIÓN DE ENTORNO ---
detectar_gestor() {
    if command -v pkg >/dev/null 2>&1; then
        echo "ios"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "debian"
    elif command -v apk >/dev/null 2>&1; then
        echo "alpine"
    elif command -v pacman >/dev/null 2>&1; then
        echo "arch"
    elif command -v dnf >/dev/null 2>&1; then
        echo "fedora"
    else
        echo "desconocido"
    fi
}

ENTORNO=$(detectar_gestor)

# --- FUNCIONES DE INSTALACIÓN ---
instalar_paquete() {
    PKG=$1
    case "$ENTORNO" in
        ios)
            echo "📱 [Bacusp / a-shell] Instalando '$PKG' vía pkg..."
            pkg install "$PKG"
            ;;
        debian)
            echo "🌀 [Bacusp / Debian] Instalando '$PKG' vía APT..."
            sudo apt-get update -y && sudo apt-get install -y "$PKG"
            ;;
        alpine)
            echo "🐧 [Bacusp / Alpine] Instalando '$PKG' vía apk..."
            apk add --no-cache "$PKG"
            ;;
        arch)
            echo "🏹 [Bacusp / Arch] Instalando '$PKG' vía pacman..."
            sudo pacman -S --noconfirm "$PKG"
            ;;
        fedora)
            echo "🎩 [Bacusp / Fedora] Instalando '$PKG' vía dnf..."
            sudo dnf install -y "$PKG"
            ;;
        *)
            echo "❌ No se encontró un gestor compatible en este sistema."
            exit 1
            ;;
    esac
}

# --- FUNCIONES DE BORRADO ---
borrar_paquete() {
    PKG=$1
    case "$ENTORNO" in
        ios) pkg uninstall "$PKG" ;;
        debian) sudo apt-get remove -y "$PKG" ;;
        alpine) apk del "$PKG" ;;
        arch) sudo pacman -R --noconfirm "$PKG" ;;
        fedora) sudo dnf remove -y "$PKG" ;;
    esac
}

# --- LÓGICA DE COMANDOS ---
case "$ACCION" in
    instalar|install)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá un paquete. Ejemplo: bacusp instalar curl"
            exit 1
        fi
        instalar_paquete "$PAQUETE"
        echo "✅ ¡$PAQUETE procesado por Bacusp!"
        ;;

    borrar|remove)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá el paquete a desinstalar."
            exit 1
        fi
        echo "🗑️ Desinstalando '$PAQUETE'..."
        borrar_paquete "$PAQUETE"
        echo "✅ Paquete removido."
        ;;

    actualizar|update)
        echo "🔄 Sincronizando repositorios para el entorno: $ENTORNO..."
        case "$ENTORNO" in
            ios) pkg update ;;
            debian) sudo apt-get update ;;
            alpine) apk update ;;
            arch) sudo pacman -Sy ;;
            fedora) sudo dnf check-update ;;
        esac
        echo "✅ Repositorios actualizados."
        ;;

    buscar|search)
        if [ -z "$PAQUETE" ]; then
            echo "❌ Especificá qué buscar."
            exit 1
        fi
        echo "🔍 Buscando '$PAQUETE'..."
        case "$ENTORNO" in
            ios) pkg search "$PAQUETE" ;;
            debian) apt-cache search "$PAQUETE" | head -n 20 ;;
            alpine) apk search "$PAQUETE" ;;
            arch) pacman -Ss "$PAQUETE" ;;
            *) echo "Búsqueda no soportada en este entorno." ;;
        esac
        ;;

    listar|list)
        echo "📋 Programas instalados (Entorno: $ENTORNO):"
        case "$ENTORNO" in
            ios) pkg list ;;
            debian) dpkg -l | grep '^ii' | awk '{print $2}' | head -n 30 ;;
            alpine) apk info ;;
            arch) pacman -Qqe ;;
            *) echo "Listado no disponible." ;;
        esac
        ;;

    ayuda|help|--help|-h|"")
        echo "🐢 Bacusp v3.0 - Gestor Universal (Linux & iOS)"
        echo "Uso: bacusp <comando> [paquete]"
        echo ""
        echo "Comandos:"
        echo "  actualizar / update        Sincroniza los repos del sistema actual"
        echo "  buscar     / search <kw>   Busca programas"
        echo "  instalar   / install <pkg> Instala una aplicación"
        echo "  borrar     / remove  <pkg> Desinstala una aplicación"
        echo "  listar     / list          Muestra las apps instaladas"
        ;;

    *)
        echo "❌ Comando desconocido: '$ACCION'"
        echo "Usá 'bacusp ayuda' para ver las opciones."
        ;;
esac
