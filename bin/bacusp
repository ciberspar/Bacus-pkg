#!/bin/sh
# ======================================================================
#  BACUSP v5.1 Dual-Lang Pure Standalone Engine 🐢⚙️
#  Creador: ciberspar
#  Filosofía: Bilingüe (ES/EN), Autónomo, Portable y Seguro
# ======================================================================

# --- COLORES ANSI ---
VERDE='\033[1;32m'
AZUL='\033[1;34m'
CYAN='\033[1;36m'
ROJO='\033[1;31m'
MAGENTA='\033[1;35m'
AMARILLO='\033[1;33m'
RESET='\033[0m'

# --- RUTAS DE CONTROL INTERNO DE BACUSP ---
BACUSP_HOME="$HOME/.bacusp"
DB_FILE="$BACUSP_HOME/installed.db"
CACHE_DIR="$BACUSP_HOME/cache"
LOG_FILE="$BACUSP_HOME/bacusp.log"
INSTALL_DIR="/usr/local/bin"

# Si no hay permisos para /usr/local/bin (ej: a-shell o sin root), usar ~/bin
[ ! -w "/usr/local/bin" 2>/dev/null ] && INSTALL_DIR="$HOME/bin"

mkdir -p "$BACUSP_HOME" "$CACHE_DIR" "$INSTALL_DIR" 2>/dev/null

log_msg() {
    TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

# --- 1. DETECCIÓN DE ENTORNO ---
detectar_entorno() {
    if uname -r 2>/dev/null | grep -qi "hurd"; then
        echo "hurd"
    elif [ -d "/net" ] && uname -s 2>/dev/null | grep -qi "Plan9"; then
        echo "plan9"
    elif [ -d "/data/data/com.termux" ]; then
        echo "termux"
    elif command -v termux-info >/dev/null 2>&1; then
        echo "termux"
    elif [ -n "$LIBPATH" ] || uname -s 2>/dev/null | grep -qi "Darwin" || [ -d "/Documents" ]; then
        echo "ios"
    elif [ -n "$WINDIR" ] || [ -d "/C/Windows" ]; then
        echo "windows"
    elif command -v pkgman >/dev/null 2>&1; then
        echo "haiku"
    elif uname -s 2>/dev/null | grep -qi "SunOS"; then
        echo "solaris"
    elif [ -d "/kolibrios" ] || uname -m 2>/dev/null | grep -qi "kolibri"; then
        echo "kolibrios"
    elif [ -f "/etc/debian_version" ]; then
        echo "debian"
    elif [ -f "/etc/SuSE-release" ] || ([ -f /etc/os-release ] && grep -qi "suse" /etc/os-release); then
        echo "opensuse"
    elif [ -f "/etc/arch-release" ]; then
        echo "arch"
    else
        echo "universal-posix"
    fi
}

ENTORNO=$(detectar_entorno)
ACCION=$1
PAQUETE=$2

# --- 2. MOTOR DE INSTALACIÓN AUTÓNOMO ---
instalar_autonomo() {
    PAQ=$1
    echo "${CYAN}🌀 [Bacusp Pure Engine] Buscando y preparando '$PAQ' para [$ENTORNO]...${RESET}"
    log_msg "Solicitud de instalación autónoma: $PAQ en $ENTORNO"

    if [ "$ENTORNO" = "kolibrios" ]; then
        echo "${AMARILLO}🪶 [Kolibri Mode] Verificando reglas de bajo consumo para '$PAQ'...${RESET}"
    fi

    URL_REPO=$(curl -s "https://api.github.com/search/repositories?q=$PAQ" | grep '"clone_url":' | head -n 1 | awk -F'"' '{print $4}')

    if [ -n "$URL_REPO" ]; then
        echo "${VERDE}📥 Clonando repositorio oficial: $URL_REPO${RESET}"
        DIR_TEMP="$CACHE_DIR/build_$PAQ"
        rm -rf "$DIR_TEMP"
        git clone --depth 1 "$URL_REPO" "$DIR_TEMP"

        if [ -d "$DIR_TEMP" ]; then
            cd "$DIR_TEMP" || exit
            BIN_PATH="$INSTALL_DIR/$PAQ"

            echo "${CYAN}⚙️ Compilando nativamente en '$ENTORNO'...${RESET}"
            if [ -f "configure" ]; then
                ./configure --prefix="$BACUSP_HOME" && make && make install
            elif [ -f "Makefile" ] || [ -f "makefile" ]; then
                make && cp "$PAQ" "$BIN_PATH" 2>/dev/null || make install
            elif [ -f "CMakeLists.txt" ]; then
                mkdir -p build && cd build && cmake .. && make && cp "$PAQ" "$BIN_PATH" 2>/dev/null
            elif [ -f "setup.py" ]; then
                python3 setup.py install --user
            else
                if [ -f "$PAQ" ]; then
                    cp "$PAQ" "$INSTALL_DIR/"
                    chmod +x "$INSTALL_DIR/$PAQ"
                fi
            fi

            echo "$PAQ|$INSTALL_DIR/$PAQ|$(date "+%Y-%m-%d")" >> "$DB_FILE"
            echo "${VERDE}✨ ¡Instalación autónoma exitosa para '$PAQ'!${RESET}"
            log_msg "Instalado con éxito: $PAQ en $INSTALL_DIR/$PAQ"
        fi
    else
        echo "${ROJO}❌ No se encontró el paquete '$PAQ' en el registro autónomo de Bacusp.${RESET}"
        log_msg "Fallo al encontrar paquete: $PAQ"
    fi
}

# --- 3. MOTOR DE DESINSTALACIÓN AUTÓNOMO ---
desinstalar_autonomo() {
    PAQ=$1
    echo "${ROJO}🗑️ [Bacusp Pure Engine] Desinstalando '$PAQ'...${RESET}"
    
    if [ -f "$DB_FILE" ]; then
        REGISTRO=$(grep "^$PAQ|" "$DB_FILE")
        if [ -n "$REGISTRO" ]; then
            RUTA_BIN=$(echo "$REGISTRO" | awk -F'|' '{print $2}')
            if [ -f "$RUTA_BIN" ]; then
                rm -f "$RUTA_BIN"
                echo "${VERDE}✅ Archivo binario eliminado: $RUTA_BIN${RESET}"
            fi
            grep -v "^$PAQ|" "$DB_FILE" > "$DB_FILE.tmp" && mv "$DB_FILE.tmp" "$DB_FILE"
            echo "${VERDE}✨ '$PAQ' eliminado correctamente de Bacusp.${RESET}"
            log_msg "Desinstalado: $PAQ"
        else
            echo "${AMARILLO}⚠️ El paquete '$PAQ' no figura en el registro interno.${RESET}"
        fi
    else
        echo "${ROJO}❌ No hay base de datos de paquetes instalados.${RESET}"
    fi
}

# --- 4. AYUDA BILINGÜE / DUAL-LANGUAGE HELP ---
mostrar_ayuda() {
    echo ""
    echo "${CYAN}======================================================${RESET}"
    echo "${VERDE}  🐢 BACUSP v5.1 Pure Standalone Engine${RESET}"
    echo "${CYAN}======================================================${RESET}"
    echo "  Comandos Bilingües / Bilingual Commands:"
    echo "    install / instalar <paq>  - Compila e instala / Build & install"
    echo "    remove / borrar <paq>     - Elimina un paquete / Uninstall package"
    echo "    list / listar / ls        - Muestra instalados / Show installed pkgs"
    echo "    audit / auditar           - Auditoría de seguridad / Security audit"
    echo "    optimize / optimizar      - Reduce peso de binarios / Compress binaries"
    echo "    export / exportar         - Exporta entorno tar.gz / Backup env"
    echo "    fetch / sysinfo           - Muestra specs y ASCII / Show specs & ASCII"
    echo "    clean / limpiar           - Limpia caché / Clear temporary cache"
    echo "    help / ayuda              - Muestra esta guía / Display this guide"
    echo ""
    echo "  Entorno detectado / OS: ${AMARILLO}$ENTORNO${RESET}"
    echo "  Base de datos / Local DB: ${CYAN}$DB_FILE${RESET}"
    echo "${CYAN}======================================================${RESET}"
    echo ""
}

# --- 5. ENRUTADOR PRINCIPAL BILINGÜE ---
case "$ACCION" in
    install|instalar|i)
        [ -z "$PAQUETE" ] && { echo "${ROJO}❌ Error: Especificá un paquete / Specify a package.${RESET}"; exit 1; }
        instalar_autonomo "$PAQUETE"
        ;;

    remove|borrar|rm|desinstalar)
        [ -z "$PAQUETE" ] && { echo "${ROJO}❌ Error: Especificá un paquete / Specify a package.${RESET}"; exit 1; }
        desinstalar_autonomo "$PAQUETE"
        ;;

    list|listar|ls)
        echo "${CYAN}📦 Paquetes gestionados por Bacusp Pure Engine:${RESET}"
        if [ -f "$DB_FILE" ]; then
            awk -F'|' '{print "  - " $1 " (Ruta: " $2 " | Fecha: " $3 ")"}' "$DB_FILE"
        else
            echo "  (No hay paquetes instalados todavía / No packages installed yet)"
        fi
        ;;

    audit|auditar)
        [ -f "$(dirname "$0")/../modules/audit.sh" ] && sh "$(dirname "$0")/../modules/audit.sh"
        ;;

    optimize|optimizar)
        [ -f "$(dirname "$0")/../modules/optimize.sh" ] && sh "$(dirname "$0")/../modules/optimize.sh"
        ;;

    export|exportar)
        [ -f "$(dirname "$0")/../modules/export.sh" ] && sh "$(dirname "$0")/../modules/export.sh"
        ;;

    clean|limpiar)
        echo "${CYAN}🧹 Limpiando caché y temporales de Bacusp...${RESET}"
        rm -rf "$CACHE_DIR"/*
        echo "${VERDE}✅ Caché interna vaciada con éxito / Cache cleared.${RESET}"
        ;;

    fetch|sysinfo)
        if [ -f "$(dirname "$0")/../modules/fetch.sh" ]; then
            sh "$(dirname "$0")/../modules/fetch.sh"
        else
            echo "${VERDE}🐢 Bacusp v5.1 Pure Standalone - Entorno: $ENTORNO${RESET}"
        fi
        ;;

    help|ayuda|h|*)
        mostrar_ayuda
        ;;
esac
