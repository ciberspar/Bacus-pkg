#!/bin/sh
# ======================================================================
#  BACUSP v5.0 Pure Standalone - Universal & Independent Manager 🐢⚙️
#  Creador: ciberspar
#  Descripción: Gestor 100% autónomo sin dependencia de apt/apk/pacman/pkg
# ======================================================================

# --- COLORES ANSI ---
VERDE='\033[1;32m'
AZUL='\033[1;34m'
CYAN='\033[1;36m'
ROJO='\033[1;31m'
MAGENTA='\033[1;35m'
AMARILLO='\033[1;33m'
RESET='\033[0m'

# --- RUTAS DE CONTROL INTERNO DE BACUSP ---
BACUSP_HOME="$HOME/.bacusp"
DB_FILE="$BACUSP_HOME/installed.db"
CACHE_DIR="$BACUSP_HOME/cache"
LOG_FILE="$BACUSP_HOME/bacusp.log"
INSTALL_DIR="/usr/local/bin"

# Si no hay permisos para /usr/local/bin (ej: a-shell o sin root), usar ~/bin
[ ! -w "/usr/local/bin" 2>/dev/null ] && INSTALL_DIR="$HOME/bin"

mkdir -p "$BACUSP_HOME" "$CACHE_DIR" "$INSTALL_DIR" 2>/dev/null

log_msg() {
    TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

# --- 1. DETECCIÓN DE ENTORNO (Solo para adaptar rutas y compilación) ---
detectar_entorno() {
    if uname -r | grep -qi "hurd"; then
        echo "hurd"
    elif [ -d "/net" ] && uname -s | grep -qi "Plan9"; then
        echo "plan9"
    elif [ -d "/data/data/com.termux" ]; then
        echo "termux"
    elif command -v termux-info >/dev/null 2>&1; then
        echo "termux"
    elif [ -n "$LIBPATH" ] || uname -s | grep -qi "Darwin" || [ -d "/Documents" ]; then
        echo "ios" # a-shell / iOS sandbox
    elif [ -n "$WINDIR" ] || [ -d "/C/Windows" ]; then
        echo "windows"
    elif command -v pkgman >/dev/null 2>&1; then
        echo "haiku"
    elif uname -s | grep -qi "SunOS"; then
        echo "solaris"
    elif [ -d "/kolibrios" ] || uname -m | grep -qi "kolibri"; then
        echo "kolibrios"
    elif [ -f "/etc/debian_version" ]; then
        echo "debian"
    elif [ -f "/etc/SuSE-release" ] || [ -f /etc/os-release ] && grep -qi "suse" /etc/os-release; then
        echo "opensuse"
    elif [ -f "/etc/arch-release" ]; then
        echo "arch"
    else
        echo "universal-posix"
    fi
}

ENTORNO=$(detectar_entorno)
ACCION=$1
PAQUETE=$2

# --- 2. MOTOR DE INSTALACIÓN PURAMENTE AUTÓNOMO (BACUSP NATIVO) ---
instalar_autonomo() {
    PAQ=$1
    echo "${CYAN}🌀 [Bacusp Pure Engine] Buscando y empaquetando '$PAQ' para [$ENTORNO]...${RESET}"
    log_msg "Solicitud de instalación autónoma: $PAQ en $ENTORNO"

    # Verificación especial para sistemas ultra minimalistas o empaquetados
    if [ "$ENTORNO" = "kolibrios" ]; then
        echo "${AMARILLO}🪶 [Kolibri Mode] Verificando restricciones de bajo consumo para '$PAQ'...${RESET}"
        # Regla estricta para KolibriOS / entornos ultra livianos
        echo "⚠️ Los paquetes en este entorno deben ser ejecutables nativos o binarios estáticos mínimos."
    fi

    # Consulta directa a la API pública de GitHub para obtener el código fuente o binario
    URL_REPO=$(curl -s "https://api.github.com/search/repositories?q=$PAQ" | grep '"clone_url":' | head -n 1 | awk -F'"' '{print $4}')

    if [ -n "$URL_REPO" ]; then
        echo "${VERDE}📥 Clonando fuente oficial: $URL_REPO${RESET}"
        DIR_TEMP="$CACHE_DIR/build_$PAQ"
        rm -rf "$DIR_TEMP"
        git clone --depth 1 "$URL_REPO" "$DIR_TEMP"

        if [ -d "$DIR_TEMP" ]; then
            cd "$DIR_TEMP" || exit
            BIN_PATH="$INSTALL_DIR/$PAQ"

            echo "${CYAN}⚙️ Compilando de forma independiente en '$ENTORNO'...${RESET}"
            if [ -f "configure" ]; then
                ./configure --prefix="$BACUSP_HOME" && make && make install
            elif [ -f "Makefile" ] || [ -f "makefile" ]; then
                make && cp "$PAQ" "$BIN_PATH" 2>/dev/null || make install
            elif [ -f "CMakeLists.txt" ]; then
                mkdir -p build && cd build && cmake .. && make && cp "$PAQ" "$BIN_PATH" 2>/dev/null
            elif [ -f "setup.py" ]; then
                python3 setup.py install --user
            else
                # Si hay un script ejecutable directo o binario
                if [ -f "$PAQ" ]; then
                    cp "$PAQ" "$INSTALL_DIR/"
                    chmod +x "$INSTALL_DIR/$PAQ"
                fi
            fi

            # Registrar en la base de datos propia de Bacusp
            echo "$PAQ|$INSTALL_DIR/$PAQ|$(date "+%Y-%m-%d")" >> "$DB_FILE"
            echo "${VERDE}✨ ¡Instalación autónoma exitosa para '$PAQ'!${RESET}"
            log_msg "Instalado con éxito: $PAQ en $INSTALL_DIR/$PAQ"
        fi
    else
        echo "${ROJO}❌ No se encontró el paquete '$PAQ' en el índice autónomo de Bacusp.${RESET}"
        log_msg "Fallo al encontrar paquete: $PAQ"
    fi
}

# --- 3. MOTOR DE DESINSTALACIÓN PURAMENTE AUTÓNOMO ---
desinstalar_autonomo() {
    PAQ=$1
    echo "${ROJO}🗑️ [Bacusp Pure Engine] Desinstalando '$PAQ' de la base de datos interna...${RESET}"
    
    if [ -f "$DB_FILE" ]; then
        # Buscar la ruta del binario en la base de datos
        REGISTRO=$(grep "^$PAQ|" "$DB_FILE")
        if [ -n "$REGISTRO" ]; then
            RUTA_BIN=$(echo "$REGISTRO" | awk -F'|' '{print $2}')
            if [ -f "$RUTA_BIN" ]; then
                rm -f "$RUTA_BIN"
                echo "${VERDE}✅ Archivo binario eliminado: $RUTA_BIN${RESET}"
            fi
            # Limpiar de la base de datos
            grep -v "^$PAQ|" "$DB_FILE" > "$DB_FILE.tmp" && mv "$DB_FILE.tmp" "$DB_FILE"
            echo "${VERDE}✨ '$PAQ' eliminado correctamente por Bacusp.${RESET}"
            log_msg "Desinstalado: $PAQ"
        else
            echo "${AMARILLO}⚠️ El paquete '$PAQ' no figura en el registro interno de Bacusp.${RESET}"
        fi
    else
        echo "${ROJO}❌ No hay base de datos de paquetes instalados.${RESET}"
    fi
}

# --- 4. AYUDA GENERAL COMPATIBLE ---
mostrar_ayuda() {
    echo ""
    echo "${CYAN}======================================================${RESET}"
    echo "${VERDE}  🐢 BACUSP v5.0 Pure Standalone - Independent Manager${RESET}"
    echo "${CYAN}======================================================${RESET}"
    echo "  Comandos del sistema autónomo:"
    echo "    bacusp install <paq>   - Compila e instala de forma 100% independiente"
    echo "    bacusp remove <paq>    - Borra el paquete del registro y rutas de Bacusp"
    echo "    bacusp list            - Muestra paquetes instalados en la DB propia"
    echo "    bacusp fetch           - Muestra specs y entorno actual"
    echo "    bacusp clean           - Limpia caché y archivos temporales"
    echo "    bacusp help            - Muestra esta ayuda"
    echo ""
    echo "  Entorno detectado / OS: ${AMARILLO}$ENTORNO${RESET}"
    echo "  Base de datos interna:  ${CYAN}$DB_FILE${RESET}"
    echo "${CYAN}======================================================${RESET}"
    echo ""
}

# --- 5. ENRUTADOR PRINCIPAL ---
case "$ACCION" in
    install|instalar|i)
        [ -z "$PAQUETE" ] && { echo "${ROJO}❌ Error: Especificá un paquete para instalar.${RESET}"; exit 1; }
        instalar_autonomo "$PAQUETE"
        ;;

    remove|borrar|rm)
        [ -z "$PAQUETE" ] && { echo "${ROJO}❌ Error: Especificá un paquete para desinstalar.${RESET}"; exit 1; }
        desinstalar_autonomo "$PAQUETE"
        ;;

    list|ls)
        echo "${CYAN}📦 Paquetes gestionados por Bacusp Pure Engine:${RESET}"
        if [ -f "$DB_FILE" ]; then
            cat "$DB_FILE" | awk -F'|' '{print "  - " $1 " (Ruta: " $2 " | Fecha: " $3 ")"}'
        else
            echo "  (No hay paquetes instalados todavía)"
        fi
        ;;

    clean)
        echo "${CYAN}🧹 Limpiando caché y temporales de Bacusp...${RESET}"
        rm -rf "$CACHE_DIR"/*
        echo "${VERDE}✅ Caché interna vaciada con éxito.${RESET}"
        ;;

    fetch|sysinfo)
        if [ -f "$(dirname "$0")/../modules/fetch.sh" ]; then
            sh "$(dirname "$0")/../modules/fetch.sh"
        else
            echo "${VERDE}🐢 Bacusp v5.0 Pure Standalone - Entorno: $ENTORNO${RESET}"
            echo "Directorio de binarios: $INSTALL_DIR"
        fi
        ;;

    help|ayuda|*)
        mostrar_ayuda
        ;;
esac
