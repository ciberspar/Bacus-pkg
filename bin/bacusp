
#!/bin/sh
#
# BACUSP v7.3 - Modular Package Manager Frontend
# Project: Bacus-Pkg
# Author: ciberspar
# Target: ChiquiOS / POSIX-compatible environments
#

set -u

VERSION="7.3"
APP="BACUSP"

# ---------- Colors ----------
if [ -t 1 ]; then
    VERDE=$(printf '\033[0;32m')
    AZUL=$(printf '\033[0;34m')
    CYAN=$(printf '\033[0;36m')
    ROJO=$(printf '\033[0;31m')
    AMARILLO=$(printf '\033[0;33m')
    RESET=$(printf '\033[0m')
else
    VERDE=""
    AZUL=""
    CYAN=""
    ROJO=""
    AMARILLO=""
    RESET=""
fi

# ---------- Paths ----------
BACUSP_HOME="${BACUSP_HOME:-${HOME:-/tmp}/.bacusp}"
CACHE_DIR="$BACUSP_HOME/cache"
LOG_FILE="$BACUSP_HOME/bacusp.log"
DB_FILE="$BACUSP_HOME/installed.db"

SCRIPT_DIR=$(
    CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null &&
    pwd -P
) || {
    printf '%s\n' "BACUSP: cannot determine script directory." >&2
    exit 1
}

MODULE_DIR="${BACUSP_MODULE_DIR:-$SCRIPT_DIR/../modules}"

mkdir -p "$BACUSP_HOME" "$CACHE_DIR" || {
    printf '%s\n' "BACUSP: cannot create its data directory." >&2
    exit 1
}

# ---------- Messages and logging ----------
log_msg() {
    printf '%s [%s] %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown)" \
        "$APP" "$*" >> "$LOG_FILE" 2>/dev/null || :
}

info() {
    printf '%s%s%s\n' "$CYAN" "$*" "$RESET"
}

success() {
    printf '%s%s%s\n' "$VERDE" "$*" "$RESET"
}

warn() {
    printf '%s%s%s\n' "$AMARILLO" "$*" "$RESET" >&2
}

error() {
    printf '%s%s%s\n' "$ROJO" "$*" "$RESET" >&2
}

# ---------- Platform detection ----------
detectar_entorno() {
    OS_NAME=$(uname -s 2>/dev/null || printf unknown)

    case "$OS_NAME" in
        Linux)
            if [ -r /etc/os-release ]; then
                ID=""
                ID_LIKE=""
                # shellcheck disable=SC1091
                . /etc/os-release

                case "${ID:-}" in
                    debian)   printf 'debian'; return ;;
                    ubuntu)   printf 'ubuntu'; return ;;
                    arch)     printf 'arch'; return ;;
                    fedora)   printf 'fedora'; return ;;
                    opensuse*) printf 'opensuse'; return ;;
                    alpine)   printf 'alpine'; return ;;
                esac

                case " ${ID_LIKE:-} " in
                    *" debian "*) printf 'debian-like'; return ;;
                    *" arch "*)   printf 'arch-like'; return ;;
                    *" fedora "*) printf 'fedora-like'; return ;;
                esac
            fi
            printf 'linux-unknown'
            ;;
        Darwin)  printf 'darwin' ;;
        FreeBSD) printf 'freebsd' ;;
        OpenBSD) printf 'openbsd' ;;
        NetBSD)  printf 'netbsd' ;;
        GNU)     printf 'hurd' ;;
        Haiku)   printf 'haiku' ;;
        *)
            if [ -n "${TERMUX_VERSION:-}" ]; then
                printf 'termux'
            else
                printf 'posix-unknown'
            fi
            ;;
    esac
}

ENTORNO=$(detectar_entorno)
ACCION=${1:-help}

# ---------- Engine discovery ----------
BACUSPKG_BIN="${BACUSPKG_BIN:-}"

encontrar_motor() {
    if [ -n "$BACUSPKG_BIN" ]; then
        if [ -x "$BACUSPKG_BIN" ] && [ ! -d "$BACUSPKG_BIN" ]; then
            printf '%s\n' "$BACUSPKG_BIN"
            return 0
        fi
        return 1
    fi

    for candidate in \
        "$SCRIPT_DIR/bacus-pkg" \
        "$SCRIPT_DIR/bacuspkg" \
        "$SCRIPT_DIR/../bacus-pkg/bin/bacus-pkg"
    do
        if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    command -v bacus-pkg 2>/dev/null
}

motor_no_conectado() {
    error "Bacus-Pkg engine is not configured for this operation."
    warn "Platform / Plataforma: $ENTORNO"
    warn "No native package manager fallback was used."
    log_msg "Engine unavailable: action=$ACCION platform=$ENTORNO"
    return 2
}

# ---------- Module dispatcher ----------
ejecutar_modulo() {
    modulo=$1
    shift

    archivo="$MODULE_DIR/$modulo.sh"

    if [ ! -f "$archivo" ]; then
        error "Module not found / Modulo no encontrado: $modulo"
        log_msg "Missing module: $modulo"
        return 2
    fi

    if [ ! -r "$archivo" ]; then
        error "Module is not readable / Modulo no legible: $modulo"
        log_msg "Unreadable module: $modulo"
        return 2
    fi

    log_msg "Running module=$modulo platform=$ENTORNO"

    sh "$archivo" "$@"
    resultado=$?

    if [ "$resultado" -ne 0 ]; then
        log_msg "Module failed: $modulo exit=$resultado"
    fi

    return "$resultado"
}

# ---------- System information ----------
mostrar_sistema() {
    printf '%s\n' "BACUSP v$VERSION"
    printf 'Platform / Plataforma: %s\n' "$ENTORNO"
    printf 'Architecture / Arquitectura: %s\n' \
        "$(uname -m 2>/dev/null || printf unknown)"
    printf 'Kernel / Nucleo: %s\n' \
        "$(uname -r 2>/dev/null || printf unknown)"
    printf 'Module directory / Modulos: %s\n' "$MODULE_DIR"
    printf 'Data directory / Datos: %s\n' "$BACUSP_HOME"

    if motor=$(encontrar_motor); then
        printf 'Bacus-Pkg engine / Motor: %s\n' "$motor"
    else
        printf '%s\n' "Bacus-Pkg engine / Motor: not detected"
    fi
}

# ---------- Bilingual help ----------
mostrar_ayuda() {
    cat <<EOF
BACUSP v$VERSION - Bacus-Pkg
Gestor de paquetes / Package manager

USO / USAGE
  bacusp COMANDO [ARGUMENTOS]

PAQUETES / PACKAGES
  install PAQUETE.bp
    Instalar un paquete Bacus
    Install a Bacus package

  remove NOMBRE
    Desinstalar un paquete
    Remove a package

  purge NOMBRE
    Eliminar paquete y configuracion
    Remove package and configuration

  list
    Listar paquetes instalados
    List installed packages

  search TEXTO
    Buscar paquetes
    Search packages

  info NOMBRE
    Mostrar informacion del paquete
    Show package information

  deps NOMBRE
    Consultar dependencias
    Inspect dependencies

  repo list|add|remove
    Gestionar repositorios configurados
    Manage configured repositories

  upgrade
    Actualizar paquetes instalados
    Upgrade installed packages

FORMATO BP / BP FORMAT
  convert ARCHIVO
    Crear ARCHIVO.bp
    Create ARCHIVO.bp

  convert ORIGEN DESTINO.bp
    Convertir un archivo al formato BP
    Convert a file to BP format

  convert --portable ARCHIVO
    Crear ARCHIVO-portable.bp
    Create ARCHIVO-portable.bp

  bridge ARCHIVO [PLATAFORMA]
    Analizar compatibilidad
    Analyze compatibility

  verify ARCHIVO.bp
    Verificar el paquete BP
    Verify a BP package

SISTEMA / SYSTEM
  system
    Informacion del sistema
    System information

  doctor
    Diagnosticar Bacus-Pkg
    Diagnose Bacus-Pkg

  audit
    Revisar registros
    Review logs

  version
    Mostrar version y plataforma
    Show version and platform

MANTENIMIENTO / MAINTENANCE
  clean
    Limpiar cache
    Clean cache

  backup
    Crear respaldo
    Create backup

  export
    Exportar datos
    Export data

  optimize
    Optimizar datos
    Optimize data

INTERFAZ / INTERFACE
  gui | tui | store
    Abrir interfaz de paquetes
    Open package interface

  aliases
    Mostrar alias disponibles
    Show available aliases

RED / NETWORK
  friends
    Comunidad Bacus
    Bacus community

  speedtest
    Probar la red
    Test network

AYUDA / HELP
  help
    Mostrar esta ayuda
    Show this help

SEGURIDAD / SECURITY
  Un archivo convertido no garantiza compatibilidad.
  Conversion does not guarantee compatibility.
  No se ejecutan scripts externos automaticamente.
  External scripts are not run automatically.

VARIABLES / ENVIRONMENT
  BACUSP_HOME
  BACUSP_MODULE_DIR
  BACUSPKG_BIN
EOF
}

# ---------- Command routing ----------
case "$ACCION" in
    help|ayuda|-h|--help|h)
        mostrar_ayuda
        ;;

    version|version-bacus|--version|-V)
        mostrar_sistema
        ;;

    system|sistema|fetch|sysinfo)
        shift
        if [ -f "$MODULE_DIR/fetch.sh" ]; then
            ejecutar_modulo fetch "$@"
        elif [ -f "$MODULE_DIR/sysinfo.sh" ]; then
            ejecutar_modulo sysinfo "$@"
        else
            mostrar_sistema
        fi
        ;;

    install|instalar|i)
        shift
        ejecutar_modulo install "$@"
        ;;

    remove|borrar|desinstalar|rm)
        shift
        ejecutar_modulo remove "$@"
        ;;

    purge|purgar)
        shift
        ejecutar_modulo purge "$@"
        ;;

    list|listar|ls)
        shift
        ejecutar_modulo list "$@"
        ;;

    search|buscar|s)
        shift
        ejecutar_modulo search "$@"
        ;;

    info|informacion|información|detalles)
        shift
        ejecutar_modulo info "$@"
        ;;

    deps|dependencias|depend)
        shift
        ejecutar_modulo deps "$@"
        ;;

    repo|repositorio|repos)
        shift
        ejecutar_modulo repo "$@"
        ;;

    upgrade|actualizar|up)
        shift
        ejecutar_modulo upgrade "$@"
        ;;

    update|actualizar-bacus|self-update)
        shift
        ejecutar_modulo update "$@"
        ;;

    convert|convertir|conv)
        shift
        ejecutar_modulo convert "$@"
        ;;

    bridge|puente)
        shift
        ejecutar_modulo bridge "$@"
        ;;

    verify|verificar|check)
        shift
        ejecutar_modulo verify "$@"
        ;;

    doctor|salud|diagnostico|diagnóstico)
        shift
        ejecutar_modulo doctor "$@"
        ;;

    audit|auditar|auditoria|auditoría)
        shift
        ejecutar_modulo audit "$@"
        ;;

    clean|limpiar|cleanup)
        shift
        ejecutar_modulo clean "$@"
        ;;

    backup|respaldo|copia)
        shift
        ejecutar_modulo backup "$@"
        ;;

    export|exportar)
        shift
        ejecutar_modulo export "$@"
        ;;

    optimize|optimizar)
        shift
        ejecutar_modulo optimize "$@"
        ;;

    friends|amigos|comunidad)
        shift
        ejecutar_modulo friends "$@"
        ;;

    aliases|alias|atajos)
        shift
        ejecutar_modulo aliases "$@"
        ;;

    gui|tui|store|tienda|tienda-gui|interfaz)
        shift
        if [ -f "$MODULE_DIR/store_tui.sh" ]; then
            ejecutar_modulo store_tui "$@"
        elif [ -f "$MODULE_DIR/storegui.sh" ]; then
            ejecutar_modulo storegui "$@"
        elif [ -f "$MODULE_DIR/gui.sh" ]; then
            ejecutar_modulo gui "$@"
        else
            error "No package interface module is installed."
            error "No hay un modulo de interfaz instalado."
            exit 2
        fi
        ;;

    speedtest|velocidad|test-red)
        shift
        ejecutar_modulo speedtest "$@"
        ;;

    nuke-native|destruir-nativo|nuke)
        error "This command is disabled."
        warn "Removing native package-management components can break the OS."
        warn "Eliminar componentes nativos puede danar el sistema."
        log_msg "Blocked unsafe native package manager removal request"
        exit 2
        ;;

    *)
        error "Unknown command / Comando desconocido: $ACCION"
        printf '%s\n' "Run 'bacusp help' or 'bacusp ayuda'."
        exit 2
        ;;
esac

exit $?
