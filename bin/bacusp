
#!/bin/sh
#
# BACUSP v7.4 - Modular Package Manager Frontend
# Project: Bacus-Pkg
# Author: ciberspar
# Target: ChiquiOS / POSIX-compatible environments
# Languages: Spanish / English
#

set -u

VERSION="7.4"
APP="BACUSP"

# ---------- Colors ----------
if [ -t 1 ]; then
    VERDE=$(printf '\033[0;32m')
    AZUL=$(printf '\033[0;34m')
    CYAN=$(printf '\033[0;36m')
    ROJO=$(printf '\033[0;31m')
    AMARILLO=$(printf '\033[0;33m')
    RESET=$(printf '\033[0m')
else
    VERDE=""
    AZUL=""
    CYAN=""
    ROJO=""
    AMARILLO=""
    RESET=""
fi

# ---------- Paths ----------
BACUSP_HOME="${BACUSP_HOME:-${HOME:-/tmp}/.bacusp}"
CACHE_DIR="$BACUSP_HOME/cache"
LOG_FILE="$BACUSP_HOME/bacusp.log"
DB_FILE="$BACUSP_HOME/installed.db"

SCRIPT_DIR=$(
    CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null &&
    pwd -P
) || {
    printf '%s\n' "BACUSP: cannot determine script directory." >&2
    exit 1
}

MODULE_DIR="${BACUSP_MODULE_DIR:-$SCRIPT_DIR/../modules}"

if ! mkdir -p "$BACUSP_HOME" "$CACHE_DIR"; then
    printf '%s\n' "BACUSP: cannot create its data directory." >&2
    exit 1
fi

# ---------- Logging ----------
log_msg() {
    printf '%s [%s] %s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown)" \
        "$APP" "$*" >> "$LOG_FILE" 2>/dev/null || :
}

info() {
    printf '%s%s%s\n' "$CYAN" "$*" "$RESET"
}

success() {
    printf '%s%s%s\n' "$VERDE" "$*" "$RESET"
}

warn() {
    printf '%s%s%s\n' "$AMARILLO" "$*" "$RESET" >&2
}

error() {
    printf '%s%s%s\n' "$ROJO" "$*" "$RESET" >&2
}

# ---------- Platform detection ----------
detectar_entorno() {
    OS_NAME=$(uname -s 2>/dev/null || printf unknown)

    case "$OS_NAME" in
        Linux)
            if [ -n "${TERMUX_VERSION:-}" ] ||
               { [ -n "${PREFIX:-}" ] && [ -x "${PREFIX}/bin/pkg" ]; }
            then
                printf '%s\n' "termux"
                return
            fi

            if [ -r /etc/os-release ]; then
                ID=""
                ID_LIKE=""
                # shellcheck disable=SC1091
                . /etc/os-release

                case "${ID:-}" in
                    debian) printf '%s\n' "debian"; return ;;
                    ubuntu) printf '%s\n' "ubuntu"; return ;;
                    arch) printf '%s\n' "arch"; return ;;
                    fedora) printf '%s\n' "fedora"; return ;;
                    opensuse*|opensuse-tumbleweed|opensuse-leap)
                        printf '%s\n' "opensuse"
                        return
                        ;;
                    alpine) printf '%s\n' "alpine"; return ;;
                esac

                case " ${ID_LIKE:-} " in
                    *" debian "*) printf '%s\n' "debian-like"; return ;;
                    *" arch "*) printf '%s\n' "arch-like"; return ;;
                    *" fedora "*) printf '%s\n' "fedora-like"; return ;;
                esac
            fi

            printf '%s\n' "linux-unknown"
            ;;
        Darwin)  printf '%s\n' "darwin" ;;
        FreeBSD) printf '%s\n' "freebsd" ;;
        OpenBSD) printf '%s\n' "openbsd" ;;
        NetBSD)  printf '%s\n' "netbsd" ;;
        GNU)     printf '%s\n' "hurd" ;;
        Haiku)   printf '%s\n' "haiku" ;;
        *)
            printf '%s\n' "posix-unknown"
            ;;
    esac
}

ENTORNO=$(detectar_entorno)

# ---------- Engine discovery ----------
BACUSPKG_BIN="${BACUSPKG_BIN:-}"

encontrar_motor() {
    if [ -n "$BACUSPKG_BIN" ]; then
        if [ -x "$BACUSPKG_BIN" ] && [ ! -d "$BACUSPKG_BIN" ]; then
            printf '%s\n' "$BACUSPKG_BIN"
            return 0
        fi
        return 1
    fi

    for candidate in \
        "$SCRIPT_DIR/bacus-pkg" \
        "$SCRIPT_DIR/bacuspkg" \
        "$SCRIPT_DIR/../bacus-pkg/bin/bacus-pkg"
    do
        if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    command -v bacus-pkg 2>/dev/null
}

# ---------- Module dispatcher ----------
ejecutar_modulo() {
    modulo=$1
    shift

    archivo="$MODULE_DIR/$modulo.sh"

    if [ ! -f "$archivo" ]; then
        error "Module not found / Módulo no encontrado: $modulo"
        warn "Ruta esperada / Expected path: $archivo"
        log_msg "Missing module: $modulo"
        return 2
    fi

    if [ ! -r "$archivo" ]; then
        error "Module is not readable / Módulo no legible: $modulo"
        log_msg "Unreadable module: $modulo"
        return 2
    fi

    log_msg "Running module=$modulo platform=$ENTORNO"

    # Los módulos se ejecutan con sh para no depender de chmod.
    sh "$archivo" "$@"
    resultado=$?

    if [ "$resultado" -eq 0 ]; then
        log_msg "Module completed: $modulo"
    else
        log_msg "Module failed: $modulo exit=$resultado"
    fi

    return "$resultado"
}

# ---------- System information ----------
mostrar_sistema() {
    printf '\n%s\n' "BACUSP v$VERSION"
    printf '%s\n' "----------------------------------------"
    printf 'Platform / Plataforma: %s\n' "$ENTORNO"
    printf 'Architecture / Arquitectura: %s\n' \
        "$(uname -m 2>/dev/null || printf unknown)"
    printf 'Kernel / Núcleo: %s\n' \
        "$(uname -r 2>/dev/null || printf unknown)"
    printf 'Module directory / Módulos: %s\n' "$MODULE_DIR"
    printf 'Data directory / Datos: %s\n' "$BACUSP_HOME"
    printf 'Cache: %s\n' "$CACHE_DIR"
    printf 'Database / Base de datos: %s\n' "$DB_FILE"

    if motor=$(encontrar_motor); then
        printf 'Bacus-Pkg engine / Motor: %s\n' "$motor"
    else
        printf '%s\n' "Bacus-Pkg engine / Motor: not detected"
    fi
}

# ---------- Bilingual help ----------
mostrar_ayuda() {
    cat <<EOF
BACUSP v$VERSION - Bacus-Pkg
Gestor modular de paquetes / Modular package manager

USO / USAGE
  bacusp COMANDO [ARGUMENTOS]
  bacusp help
  bacusp version

PAQUETES / PACKAGES
  install ARCHIVO.bp
    Instalar un paquete BP
    Install a BP package

  install ARCHIVO.deb|.rpm|.apk
    Usar el gestor nativo compatible
    Use the compatible native package manager

  remove NOMBRE
    Desinstalar un paquete
    Remove a package

  purge NOMBRE
    Eliminar paquete y configuración
    Remove package and configuration

  list
    Listar paquetes instalados
    List installed packages

  search TEXTO
    Buscar paquetes
    Search packages

  info NOMBRE
    Mostrar información del paquete
    Show package information

  deps NOMBRE
    Consultar dependencias
    Inspect dependencies

  repo list|add|remove
    Gestionar repositorios
    Manage repositories

ACTUALIZACIONES / UPDATES
  update [--lang es|en]
    Abrir el centro TUI de actualizaciones
    Open the update TUI

  upgrade
    Alias de update
    Alias for update

FORMATO BP / BP FORMAT
  convert ORIGEN
    Crear un archivo .bp
    Create a .bp file

  convert ORIGEN DESTINO.bp
    Empaquetar un archivo como BP
    Package one file as BP

  convert --portable ORIGEN [DESTINO.bp]
    Crear un paquete marcado como portable
    Create a package marked as portable

  verify ARCHIVO.bp
    Validar estructura e integridad SHA-256
    Validate structure and SHA-256 integrity

  bridge ARCHIVO [PLATAFORMA]
    Analizar compatibilidad
    Analyze compatibility

MANTENIMIENTO / MAINTENANCE
  clean
    Limpiar caché de Bacus-Pkg
    Clean the Bacus-Pkg cache

  backup
    Crear respaldo
    Create a backup

  export
    Exportar datos
    Export data

  optimize
    Optimizar datos locales
    Optimize local data

SISTEMA / SYSTEM
  system
    Mostrar información del sistema
    Show system information

  doctor
    Diagnosticar Bacus-Pkg
    Diagnose Bacus-Pkg

  audit
    Revisar registros
    Review logs

  version
    Mostrar versión y plataforma
    Show version and platform

INTERFAZ / INTERFACE
  gui | tui | store
    Abrir la interfaz disponible
    Open the available interface

  aliases
    Mostrar alias disponibles
    Show available aliases

RED / NETWORK
  friends
    Comunidad Bacus
    Bacus community

  speedtest
    Probar la red
    Test network

AYUDA / HELP
  help | ayuda
    Mostrar esta ayuda
    Show this help

SEGURIDAD / SECURITY
  verify comprueba estructura e integridad, no malware.
  verify checks structure and integrity, not malware.

  convert empaqueta el archivo original; no lo transforma
  automáticamente en una aplicación nativa.
  convert wraps the original file; it does not automatically
  transform it into a native application.

  Las actualizaciones del sistema requieren confirmación.
  System updates require confirmation.

VARIABLES / ENVIRONMENT
  BACUSP_HOME
  BACUSP_MODULE_DIR
  BACUSPKG_BIN
  BACUSP_LANG
EOF
}

# ---------- Command routing ----------
ACCION=${1:-help}

case "$ACCION" in
    help|ayuda|-h|--help|h)
        mostrar_ayuda
        ;;

    version|version-bacus|--version|-V)
        mostrar_sistema
        ;;

    system|sistema|fetch|sysinfo)
        shift
        if [ -f "$MODULE_DIR/fetch.sh" ]; then
            ejecutar_modulo fetch "$@"
        elif [ -f "$MODULE_DIR/sysinfo.sh" ]; then
            ejecutar_modulo sysinfo "$@"
        else
            mostrar_sistema
        fi
        ;;

    install|instalar|i)
        shift
        ejecutar_modulo install "$@"
        ;;

    remove|borrar|desinstalar|rm)
        shift
        ejecutar_modulo remove "$@"
        ;;

    purge|purgar)
        shift
        ejecutar_modulo purge "$@"
        ;;

    list|listar|ls)
        shift
        ejecutar_modulo list "$@"
        ;;

    search|buscar|s)
        shift
        ejecutar_modulo search "$@"
        ;;

    info|informacion|información|detalles)
        shift
        ejecutar_modulo info "$@"
        ;;

    deps|dependencias|depend)
        shift
        ejecutar_modulo deps "$@"
        ;;

    repo|repositorio|repos)
        shift
        ejecutar_modulo repo "$@"
        ;;

    # Both commands use the interactive update center.
    # This avoids invoking an older, potentially unsafe upgrade script.
    upgrade|actualizar|up|update|actualizar-bacus|self-update)
        shift
        ejecutar_modulo update "$@"
        ;;

    convert|convertir|conv)
        shift
        ejecutar_modulo convert "$@"
        ;;

    bridge|puente)
        shift
        ejecutar_modulo bridge "$@"
        ;;

    verify|verificar|check)
        shift
        ejecutar_modulo verify "$@"
        ;;

    doctor|salud|diagnostico|diagnóstico)
        shift
        ejecutar_modulo doctor "$@"
        ;;

    audit|auditar|auditoria|auditoría)
        shift
        ejecutar_modulo audit "$@"
        ;;

    clean|limpiar|cleanup)
        shift
        ejecutar_modulo clean "$@"
        ;;

    backup|respaldo|copia)
        shift
        ejecutar_modulo backup "$@"
        ;;

    export|exportar)
        shift
        ejecutar_modulo export "$@"
        ;;

    optimize|optimizar)
        shift
        ejecutar_modulo optimize "$@"
        ;;

    friends|amigos|comunidad)
        shift
        ejecutar_modulo friends "$@"
        ;;

    aliases|alias|atajos)
        shift
        ejecutar_modulo aliases "$@"
        ;;

    gui|tui|store|tienda|tienda-gui|interfaz)
        shift
        if [ -f "$MODULE_DIR/store_tui.sh" ]; then
            ejecutar_modulo store_tui "$@"
        elif [ -f "$MODULE_DIR/storegui.sh" ]; then
            ejecutar_modulo storegui "$@"
        elif [ -f "$MODULE_DIR/gui.sh" ]; then
            ejecutar_modulo gui "$@"
        else
            error "No package interface module is installed."
            error "No hay un módulo de interfaz instalado."
            exit 2
        fi
        ;;

    speedtest|velocidad|test-red)
        shift
        ejecutar_modulo speedtest "$@"
        ;;

    nuke-native|destruir-nativo|nuke)
        error "This command is disabled."
        warn "Removing native package managers can break the OS."
        warn "Eliminar gestores nativos puede dañar el sistema."
        log_msg "Blocked native package manager removal request"
        exit 2
        ;;

    *)
        error "Unknown command / Comando desconocido: $ACCION"
        printf '%s\n' "Ejecutá 'bacusp help' o 'bacusp ayuda'."
        exit 2
        ;;

    update|upgrade|actualizar|up|actualizar-bacus|self-update)
        shift
        ejecutar_modulo upgrade "$@"
        ;;
esac

exit $?
