#!/bin/sh
# ======================================================================
#  BACUSP WATCH DOGS DAEMON (Centinela Silencioso) 🐢👁️
#  Creador: ciberspar
#  Descripción: Monitoreo en segundo plano con bajo consumo y arranque suave.
# ======================================================================

VERDE='\033[1;32m'
CYAN='\033[1;36m'
AMARILLO='\033[1;33m'
ROJO='\033[1;31m'
MAGENTA='\033[1;35m'
RESET='\033[0m'

BACUSP_HOME="$HOME/.bacusp"
LOG_FILE="$BACUSP_HOME/bacusp.log"
DB_FILE="$BACUSP_HOME/installed.db"
INTERVALO=3600  # Revisa cada 1 hora (3600 segundos)

log_daemon() {
    TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[$TIMESTAMP] [WATCH_DOGS] $1" >> "$LOG_FILE"
}

militar_watchdog() {
    # 🛑 Espera inicial de 30s al arrancar el SO para no saturar la CPU ni el disco
    sleep 30
    log_daemon "Iniciando servicio Watch Dogs Centinela de Bacusp..."

    while true; do
        # 1. Chequeo de integridad de la base de datos
        if [ ! -f "$DB_FILE" ]; then
            touch "$DB_FILE"
            log_daemon "ALERTA: 'installed.db' no encontrada. Regenerando archivo base..."
        fi

        # 2. Monitoreo del repositorio oficial (bacus-pkg) y updates del Core
        BACUSP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
        if [ -d "$BACUSP_DIR/.git" ]; then
            cd "$BACUSP_DIR" && git fetch origin >/dev/null 2>&1
            LOCAL=$(git rev-parse HEAD 2>/dev/null)
            REMOTE=$(git rev-parse @{u} 2>/dev/null)

            if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
                echo "${CYAN}🔔 [WATCH DOGS]: ¡Hay una nueva versión de Bacusp en GitHub! Ejecutá 'bacusp upgrade'.${RESET}"
                log_daemon "NOTIFICACIÓN: Actualización remota disponible."
            fi
        fi

        # 3. Detección silenciosa de errores en logs recientes
        if [ -f "$LOG_FILE" ]; then
            ULTIMO_ERROR=$(grep -i "error\|fail\|fallo" "$LOG_FILE" | tail -n 1)
            if [ -n "$ULTIMO_ERROR" ]; then
                log_daemon "ANOMALÍA DETECTADA: $ULTIMO_ERROR"
            fi
        fi

        sleep $INTERVALO
    done
}

# Ejecutar centinela en bucle
militar_watchdog
